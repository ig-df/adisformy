            margin-top: 0.65rem;
            margin-bottom: 0;
        }

        .factory-aisle-marker.horizontal {
            width: 22px;
            height: 20px;
            margin: 0 4px;
        }

        /* 5-sloupcová síť (3 sloupce strojů + 2 žluté dopravní koridory se šipkami) */
        .factory-layout-grid {
            display: grid;
            grid-template-columns: 1fr 24px 1fr 24px 1fr;
            gap: 0.5rem;
            align-items: stretch;
        }

        .factory-col {
            display: flex;
            flex-direction: column;
        }

        .factory-col.col-left {
            justify-content: space-between;
        }

        .factory-col.col-center {
            justify-content: space-between;
        }

        .factory-col.col-right {
            justify-content: space-between;
        }

        /* Žlutý dopravní koridor VZV (Aisle) */
        .factory-aisle {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            position: relative;
            padding: 0.4rem 0;
            user-select: none;
        }

        .factory-aisle-line {
            flex: 1;
            width: 0;
            border-left: 2px dashed #f59e0b;
            opacity: 0.85;
            min-height: 20px;
        }

        .factory-aisle-marker {
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fef3c7;
            border: 1px solid #f59e0b;
            border-radius: 4px;
            width: 20px;
            height: 22px;
            box-shadow: 0 1px 2px rgba(245, 158, 11, 0.15);
            margin: 4px 0;
            flex-shrink: 0;
