    <style>
        :root {
            --bg-color: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --primary: #334155;
            --row-hover: #f8fafc;
            --input-bg: #ffffff;

            --success-bg: #f0fdf4;
            --success-border: #bbf7d0;
            --success-text: #166534;
            --success-badge: #22c55e;

            --error-bg: #fef2f2;
            --error-border: #fecaca;
            --error-text: #991b1b;
            --error-badge: #ef4444;

            --warning-badge: #f97316;
            --maintenance-badge: #facc15;
        }

        button:focus, input:focus, select:focus, textarea:focus, [tabindex]:focus {
            outline: none !important;
        }

        button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, [tabindex]:focus-visible {
            outline: none !important;
            box-shadow: none !important;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-tap-highlight-color: transparent;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            text-rendering: optimizeLegibility;
        }

        /* Custom selection */
        ::selection {
            background: #e0e7ff;
            color: #1e1b4b;
        }

        ::-moz-selection {
            background: #e0e7ff;
            color: #1e1b4b;
        }

        /* Minimalist Subtle Auto-Hiding Desktop Scrollbar */
        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
            background: transparent !important;
        }

        ::-webkit-scrollbar-track {
            background: transparent !important;
        }

        ::-webkit-scrollbar-corner {
            background: transparent !important;
        }

        /* Сдвигаем начало активной зоны скроллбара и ползунка под серую шапку таблицы */
        ::-webkit-scrollbar-button:vertical:start:decrement {
            display: block;
            height: 39px;
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: transparent;
            border-radius: 9999px;
            transition: background 0.3s ease;
        }

        body.is-scrolling ::-webkit-scrollbar-thumb,
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(148, 163, 184, 0.45);
        }

        ::-webkit-scrollbar-thumb:active {
            background: rgba(100, 116, 139, 0.7);
        }

        * {
            scrollbar-width: thin;
            scrollbar-color: transparent transparent;
        }

        body.is-scrolling,
        body.is-scrolling * {
            scrollbar-color: rgba(148, 163, 184, 0.45) transparent;
        }

        /* Tabular numbers for all precision digits and IDs */
        .mold-clickable-id, .badge-position, .status-pill, .dash-card-value, .dash-count, .log-item-date, .comment-date, .navodka-badge-item, .empty-state-title .highlight-mold, .stats-bar, .form-number-chip, table td {
            font-variant-numeric: tabular-nums;
        }

        /* Micro-tracking for headlines and compact badges */
        h1, h2, h3, .modal-header h3, .header-title {
            letter-spacing: -0.015em;
        }

        .badge-position, .badge-status, .filter-chip, .tab-btn, .tag-customer, .superuser-badge-btn, .cabinet-day-chip {
            letter-spacing: 0.018em;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            display: flex;
            justify-content: center;
            padding: 1rem 0.5rem;
            min-height: 100vh;
        }

        /* Toast Notification */
        .toast-notification {
            position: fixed;
            bottom: 28px;
            left: 50%;
            transform: translateX(-50%) translateY(80px);
            background: #ffffff;
            color: #0f172a;
            padding: 0.7rem 1.25rem;
            border-radius: 10px;
            font-size: 0.88rem;
            font-weight: 600;
            border: 1px solid var(--border-color);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
            z-index: 9999;
            opacity: 0;
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
            pointer-events: none;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .toast-notification::before {
            content: '';
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #22c55e;
            flex-shrink: 0;
        }

        .toast-notification.toast-error::before {
            background-color: #ef4444;
        }

        .toast-notification.show {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }

        .container {
            width: 100%;
            max-width: 960px;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        button:not(.toggle-accordion-btn), .filter-chip, .dash-card, .badge-position, tr, .tag-customer, .add-customer-chip, .top-icon-btn, .auth-btn, .superuser-badge-btn, .comment-item, .edit-btn, .comment-btn, .floating-corner-btn, .floating-corner-btn-left, .floating-corner-btn-list, .shift-plan-item, .mold-clickable-id, .tab-btn {
            user-select: none;
            -webkit-user-select: none;
            transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.18s ease, filter 0.18s ease, background-color 0.2s ease, box-shadow 0.2s ease;
        }

        button:not(.toggle-accordion-btn):active, .filter-chip:active, .dash-card:active, .badge-position:active, .tag-customer:active, .add-customer-chip:active, .top-icon-btn:active, .auth-btn:active, .superuser-badge-btn:active, .floating-corner-btn:active, .floating-corner-btn-left:active, .floating-corner-btn-list:active, .shift-plan-item:active, .tab-btn:active, .mold-clickable-id:active, .is-touched:not(.toggle-accordion-btn) {
