    function findDuplicateShiftPlanItem(moldNum, machineNum) {
        const cleanMold = String(moldNum || '').trim().toLowerCase();
        const cleanMach = String(machineNum || '').trim().toLowerCase();
        if (!cleanMold && !cleanMach) return null;

        return currentShiftPlan.find(p => {
            const pMold = String(p.num || '').trim().toLowerCase();
            const pMach = String(p.machine || '').trim().toLowerCase();

            if (cleanMold && cleanMach) {
                return pMold === cleanMold && pMach === cleanMach;
            }
            if (cleanMold && !cleanMach) {
                return pMold === cleanMold && !pMach;
            }
            if (!cleanMold && cleanMach) {
                return !pMold && pMach === cleanMach;
            }
            return false;
        }) || null;
    }

