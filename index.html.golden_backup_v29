    function getShiftInfo(dateInput) {
        const d = (dateInput instanceof Date) ? dateInput : new Date(dateInput);
        const hours = d.getHours();
        const minutes = d.getMinutes();
        const totalMinutes = hours * 60 + minutes;

        let shiftType = 'ranni';
        let shiftName = 'Ranní';
        let shiftBadge = 'R';
        let shiftDate = new Date(d);

        // Factory 3-shift schedule:
        // 06:00 - 14:00 (360 - 839 min) -> Ranní
        // 14:00 - 22:00 (840 - 1319 min) -> Odpolední
        // 22:00 - 06:00 (>= 1320 min OR < 360 min) -> Noční
        if (totalMinutes >= 22 * 60 || totalMinutes < 6 * 60) {
            shiftType = 'nocni';
            shiftName = 'Noční';
            shiftBadge = 'N';
            // When after midnight (00:00 - 05:59), the night shift started yesterday at 22:00
            if (totalMinutes < 6 * 60) {
                shiftDate.setDate(shiftDate.getDate() - 1);
            }
        } else if (totalMinutes >= 14 * 60) {
            shiftType = 'odpoledni';
            shiftName = 'Odpolední';
            shiftBadge = 'O';
        } else {
            shiftType = 'ranni';
            shiftName = 'Ranní';
            shiftBadge = 'R';
        }

        const year = shiftDate.getFullYear();
        const month = String(shiftDate.getMonth() + 1).padStart(2, '0');
        const day = String(shiftDate.getDate()).padStart(2, '0');
        const shiftDateStr = `${year}-${month}-${day}`;

        return {
            shiftDate,
            shiftDateStr,
            shiftType,
            shiftName,
            shiftBadge
        };
    }

    async function loadAndRenderUserCabinetStats() {
        const todayStatEl = document.getElementById('cabinetStatToday');
        const weekStatEl = document.getElementById('cabinetStatWeek');
        const monthStatEl = document.getElementById('cabinetStatMonth');
        const chipsBar = document.getElementById('cabinetDaysChipsBar');
        const drilldownContainer = document.getElementById('cabinetMoldsDrilldown');

        if (!currentUser) return;

        try {
            const { data: logs, error } = await supabaseClient
                .from('mold_logs')
                .select('*')
                .eq('user_name', currentUser)
                .order('created_at', { ascending: false })
                .limit(500);

            if (error) throw error;

            const userLogs = logs || [];
            cabinetDaysData = new Map();
            const now = new Date();
            const currentShift = getShiftInfo(now);
            const currentShiftDateStr = currentShift.shiftDateStr;

            const sevenDaysAgo = new Date(currentShift.shiftDate.getTime() - 7 * 24 * 60 * 60 * 1000);
            const startOfMonth = new Date(currentShift.shiftDate.getFullYear(), currentShift.shiftDate.getMonth(), 1);

            let todayCount = 0;
            let weekCount = 0;
            let monthCount = 0;

            const seenKeys = new Set();

            userLogs.forEach(log => {
                if (!log.created_at) return;
                const moldIdStr = String(log.mold_id || '').trim().toUpperCase();
                const oldPos = String(log.old_position || '').trim();
                const newPos = String(log.new_position || '').trim();
                const combined = (oldPos + ' ' + newPos).toLowerCase();

                // Exclude system logs, searches, raw scans, detail open, navigation, filters, exports, photo/pdf views
                if (moldIdStr === 'HLEDÁNÍ' || moldIdStr === 'SKENER' || moldIdStr === 'SYSTEM' || moldIdStr === 'PLÁN' || moldIdStr === 'NÁVODKA') return;
                if (oldPos === 'Vyhledávání' || oldPos === 'Skenování' || oldPos === 'Detail formy' || oldPos === 'Navigace' || oldPos === 'Filtr' || oldPos === 'Export') return;
                if (combined.includes('hledal:') || combined.includes('forma rozpoznána') || combined.includes('rozpoznána forma') || combined.includes('naskenován') || newPos === 'Otevřen detail formy' || combined.includes('zobrazena fot') || combined.includes('zobrazena návodk') || combined.includes('přepnutí na záložku') || combined.includes('filtr zákazníka') || combined.includes('filtr stavu') || combined.includes('export dat')) return;

                const isShiftPlanCompletion = oldPos === 'Plán na směnu' && (combined.includes('odebráno z regálu') || combined.includes('splněn úkol') || combined.includes('splněno в plánu') || combined.includes('splněno v plánu'));
                const isMainAction = isSignificantAuditLog(log, false);

                if (!isShiftPlanCompletion && !isMainAction) return;

                const logDate = new Date(log.created_at);
                const logShift = getShiftInfo(logDate);
                const dayKey = logShift.shiftDateStr;
                const moldId = String(log.mold_id || '').trim();
                const dedupeKey = `${dayKey}_${moldId}_${log.new_position}_${log.created_at}`;
                if (seenKeys.has(dedupeKey)) return;
                seenKeys.add(dedupeKey);

                if (!cabinetDaysData.has(dayKey)) {
                    cabinetDaysData.set(dayKey, {
                        date: logShift.shiftDate,
                        shiftDateStr: dayKey,
                        shiftType: logShift.shiftType,
                        shiftName: logShift.shiftName,
                        shiftBadge: logShift.shiftBadge,
                        moves: 0,
                        molds: []
                    });
                }

                const dayObj = cabinetDaysData.get(dayKey);
                dayObj.moves++;
                // Keep the shift name of the shift that produced forms (or default to logShift)
                if (!dayObj.shiftName || dayObj.shiftType === 'ranni') {
                    dayObj.shiftName = logShift.shiftName;
                    dayObj.shiftType = logShift.shiftType;
                }
                dayObj.molds.push({
                    mold_id: moldId,
                    old_position: log.old_position,
                    new_position: log.new_position,
                    created_at: log.created_at
                });

                if (dayKey === currentShiftDateStr) {
                    todayCount++;
                }
                if (logShift.shiftDate >= sevenDaysAgo) {
                    weekCount++;
                }
                if (logShift.shiftDate >= startOfMonth) {
                    monthCount++;
                }
            });

            if (todayStatEl) todayStatEl.textContent = todayCount;
            if (weekStatEl) weekStatEl.textContent = weekCount;
            if (monthStatEl) monthStatEl.textContent = monthCount;

            if (cabinetDaysData.size === 0) {
                chipsBar.innerHTML = `<span style="font-size: 0.8rem; color: var(--text-muted); padding: 0.2rem 0;">Zatím žádná historie aktivit</span>`;
                drilldownContainer.innerHTML = `
                    <div class="empty-state-card" style="padding: 1.5rem 1rem; border-color: var(--border-color); box-shadow: none;">
                        <div class="empty-state-icon-box">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                                <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                                <path d="m9 14 2 2 4-4"></path>
                            </svg>
                        </div>
                        <div class="empty-state-title" style="font-size: 0.95rem;">Žádné zpracované formy</div>
                        <div class="empty-state-desc" style="font-size: 0.8rem;">Zde se zobrazuje přehled forem zpracovaných během vaší směny.</div>
                    </div>
                `;
                return;
            }

            // Sort days descending
            const sortedDays = Array.from(cabinetDaysData.entries()).sort((a, b) => b[0].localeCompare(a[0]));

            if (!cabinetSelectedDayKey || !cabinetDaysData.has(cabinetSelectedDayKey)) {
                cabinetSelectedDayKey = sortedDays[0][0];
            }

            renderCabinetDayChips(sortedDays, currentShiftDateStr, currentShift);
            renderCabinetMoldsDrilldown();

        } catch (err) {
            console.warn('Error loading cabinet stats:', err);
            chipsBar.innerHTML = `<div class="no-data">Chyba historie</div>`;
        }
    }

    function renderCabinetDayChips(sortedDays, currentShiftDateStr, currentShift) {
        const chipsBar = document.getElementById('cabinetDaysChipsBar');
        if (!chipsBar) return;

        const baseShiftDate = currentShift ? currentShift.shiftDate : (getShiftInfo(new Date()).shiftDate);
        const yesterdayShiftDate = new Date(baseShiftDate.getTime() - 24 * 60 * 60 * 1000);
        const yYear = yesterdayShiftDate.getFullYear();
        const yMonth = String(yesterdayShiftDate.getMonth() + 1).padStart(2, '0');
        const yDay = String(yesterdayShiftDate.getDate()).padStart(2, '0');
        const yesterdayStr = `${yYear}-${yMonth}-${yDay}`;
        const czechDayNames = ['Ne', 'Po', 'Út', 'St', 'Čt', 'Pá', 'So'];

        chipsBar.innerHTML = sortedDays.map(([dayKey, stat]) => {
            let label = '';
            const parts = dayKey.split('-');
            const formattedDate = `${parts[2]}.${parts[1]}.`;
            const shiftLabel = stat.shiftName ? ` • ${stat.shiftName}` : '';

            if (dayKey === currentShiftDateStr) {
                label = `Dnes (${formattedDate})${shiftLabel}`;
            } else if (dayKey === yesterdayStr) {
                label = `Včera (${formattedDate})${shiftLabel}`;
            } else {
                const dayOfWeek = czechDayNames[stat.date.getDay()];
                label = `${dayOfWeek} ${formattedDate}${shiftLabel}`;
            }

            const isSelected = dayKey === cabinetSelectedDayKey;
            return `
                <button type="button" class="cabinet-day-chip ${isSelected ? 'active' : ''}" data-day-key="${escapeHtml(dayKey)}" onclick="selectCabinetDay('${escapeHtml(dayKey)}', this)">
                    <span>${escapeHtml(label)}</span>
                    <span class="cabinet-day-chip-count">${stat.moves}</span>
                </button>
            `;
        }).join('');
    }

