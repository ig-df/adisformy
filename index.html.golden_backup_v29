    let scannerSessionCounter = 0;

    async function startScannerCamera(deviceId = null) {
        stopScannerStream();
        const currentSession = ++scannerSessionCounter;

        try {
            const constraints = {
                video: deviceId 
                    ? { deviceId: { exact: deviceId } }
                    : { facingMode: { ideal: 'environment' }, width: { ideal: 1920 }, height: { ideal: 1080 } },
                audio: false
            };

            const stream = await navigator.mediaDevices.getUserMedia(constraints);
            
            // If scanner was closed or a new stream was requested in the meantime, stop this stream immediately
            if (currentSession !== scannerSessionCounter || !isModalOpen('numberScannerModal')) {
                stream.getTracks().forEach(t => t.stop());
                return;
            }

            scannerStream = stream;
            const video = document.getElementById('scannerVideo');
            if (video) {
                video.srcObject = scannerStream;
                try {
                    const playPromise = video.play();
                    if (playPromise !== undefined) {
                        await playPromise;
                    }
                } catch (playErr) {
                    if (playErr.name !== 'AbortError') {
                        console.warn("Chyba při spuštění přehrávání videa:", playErr);
                    }
                }
            }

            // Check again if still valid after play()
            if (currentSession !== scannerSessionCounter) {
                return;
            }

            scannerTrack = scannerStream.getVideoTracks()[0];
            isScannerRunning = true;

            // Check torch capability
            const torchBtn = document.getElementById('scannerTorchBtn');
            if (torchBtn && scannerTrack && scannerTrack.getCapabilities) {
                const caps = scannerTrack.getCapabilities();
                if (caps && caps.torch) {
                    torchBtn.style.display = 'inline-flex';
                    scannerTorchEnabled = false;
                } else {
                    torchBtn.style.display = 'none';
                }
            }

            // Enumerate cameras for flip button
            if (navigator.mediaDevices.enumerateDevices) {
                const devices = await navigator.mediaDevices.enumerateDevices();
                scannerAvailableCameras = devices.filter(d => d.kind === 'videoinput');
                const flipBtn = document.getElementById('scannerFlipBtn');
                if (flipBtn) {
                    flipBtn.style.display = (scannerAvailableCameras.length > 1) ? 'inline-flex' : 'none';
                }
            }

            const statusText = document.getElementById('scannerStatusText');
            if (statusText) {
                statusText.textContent = (scannerActiveMode === 'plan')
                    ? "Namiřte rámeček na denní plán a stiskněte tlačítko"
                    : "Namiřte rámeček na štítek a stiskněte tlačítko";
            }
        } catch (err) {
            if (err && err.name === 'AbortError') {
                return;
            }
            console.error("Kamera nedostupná:", err);
            const statusText = document.getElementById('scannerStatusText');
            if (statusText) statusText.textContent = "Nepodařilo se spustit kameru. Zkontrolujte oprávnění.";
            showToast("Přístup ke kameře byl zamítnut nebo není k dispozici.");
        }
    }

    function stopScannerStream() {
        scannerSessionCounter++;
        clearInterval(scannerScanInterval);
        isScannerRunning = false;
        if (scannerTrack) {
            try {
                if (scannerTorchEnabled) {
                    scannerTrack.applyConstraints({ advanced: [{ torch: false }] });
                }
            } catch (e) {}
            scannerTrack.stop();
            scannerTrack = null;
        }
        if (scannerStream) {
            scannerStream.getTracks().forEach(t => t.stop());
            scannerStream = null;
        }
        const video = document.getElementById('scannerVideo');
        if (video) {
            try {
                video.pause();
            } catch (e) {}
            video.srcObject = null;
        }
    }

    async function toggleScannerTorch() {
        if (!scannerTrack || !scannerTrack.getCapabilities) return;
        try {
            const caps = scannerTrack.getCapabilities();
            if (caps && caps.torch) {
                scannerTorchEnabled = !scannerTorchEnabled;
                await scannerTrack.applyConstraints({ advanced: [{ torch: scannerTorchEnabled }] });
                triggerHapticFeedback([12]);
                const torchBtn = document.getElementById('scannerTorchBtn');
                if (torchBtn) {
                    torchBtn.style.background = scannerTorchEnabled ? 'rgba(251, 191, 36, 0.3)' : 'rgba(255,255,255,0.08)';
                }
            }
        } catch (e) {
            console.warn("Chyba při ovládání svítilny:", e);
        }
    }

    async function switchScannerCamera() {
        if (scannerAvailableCameras.length <= 1) return;
        triggerHapticFeedback([14]);
        scannerCurrentCameraIndex = (scannerCurrentCameraIndex + 1) % scannerAvailableCameras.length;
        const targetDevice = scannerAvailableCameras[scannerCurrentCameraIndex];
        if (targetDevice) {
            await startScannerCamera(targetDevice.deviceId);
        }
    }

    function getCroppedReticleCanvas() {
        const video = document.getElementById('scannerVideo');
        const reticle = document.getElementById('scannerReticle');
        if (!video || !reticle || !video.videoWidth || !video.videoHeight || video.videoWidth === 0 || video.videoHeight === 0) return null;

        const videoRect = video.getBoundingClientRect();
        const reticleRect = reticle.getBoundingClientRect();

        // Calculate scale between displayed video and actual video stream
        const scaleX = video.videoWidth / videoRect.width;
        const scaleY = video.videoHeight / videoRect.height;

        // Add 6% context margin around reticle so large handwritten characters or digits touching the border are not clipped
        const padX = reticleRect.width * scaleX * 0.06;
        const padY = reticleRect.height * scaleY * 0.06;

        const rawCropX = (reticleRect.left - videoRect.left) * scaleX - padX;
        const rawCropY = (reticleRect.top - videoRect.top) * scaleY - padY;
        const rawCropW = reticleRect.width * scaleX + (padX * 2);
        const rawCropH = reticleRect.height * scaleY + (padY * 2);

        const cropX = Math.max(0, rawCropX);
        const cropY = Math.max(0, rawCropY);
        const cropW = Math.min(video.videoWidth - cropX, rawCropW);
        const cropH = Math.min(video.videoHeight - cropY, rawCropH);

        if (cropW <= 0 || cropH <= 0 || isNaN(cropW) || isNaN(cropH)) return null;

        const canvas = document.createElement('canvas');
        // High resolution with preserved aspect ratio for crisp recognition of handwritten numbers & lists
        const maxDim = 1280;
        let destW = Math.round(cropW);
        let destH = Math.round(cropH);
        if (destW > maxDim || destH > maxDim) {
            const scale = Math.min(maxDim / destW, maxDim / destH);
            destW = Math.round(destW * scale);
            destH = Math.round(destH * scale);
        }
        destW = Math.max(1, destW);
        destH = Math.max(1, destH);

        canvas.width = destW;
        canvas.height = destH;
        const ctx = canvas.getContext('2d', { willReadFrequently: true });
        
        ctx.drawImage(video, cropX, cropY, cropW, cropH, 0, 0, destW, destH);

        // Preprocessing: shadow removal & adaptive contrast for handwriting on paper
        try {
            const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
            const d = imgData.data;
            const w = canvas.width;
            const h = canvas.height;

            // Block grid background luminance estimation based on resolution
            const gridCols = Math.max(6, Math.round(w / 70));
            const gridRows = Math.max(6, Math.round(h / 70));
            const cellW = Math.ceil(w / gridCols);
            const cellH = Math.ceil(h / gridRows);
            const bgGrid = [];

            for (let gy = 0; gy < gridRows; gy++) {
                bgGrid[gy] = [];
                for (let gx = 0; gx < gridCols; gx++) {
                    const startX = gx * cellW;
                    const endX = Math.min(w, startX + cellW);
                    const startY = gy * cellH;
                    const endY = Math.min(h, startY + cellH);

                    let cellLums = [];
                    for (let y = startY; y < endY; y += 2) {
                        for (let x = startX; x < endX; x += 2) {
                            const idx = (y * w + x) * 4;
                            const lum = 0.299 * d[idx] + 0.587 * d[idx+1] + 0.114 * d[idx+2];
                            cellLums.push(lum);
                        }
                    }
                    if (cellLums.length > 0) {
                        cellLums.sort((a, b) => a - b);
                        // 85th percentile represents local paper background
                        const p85Idx = Math.floor(cellLums.length * 0.85);
                        bgGrid[gy][gx] = cellLums[p85Idx];
                    } else {
                        bgGrid[gy][gx] = 200;
                    }
                }
            }

            // Normalize pixels against local background to eliminate hand/phone shadows & preserve fine ballpoint pen strokes
            for (let y = 0; y < h; y++) {
                const gy = Math.min(gridRows - 1, Math.floor(y / cellH));
                for (let x = 0; x < w; x++) {
                    const gx = Math.min(gridCols - 1, Math.floor(x / cellW));
                    const localBg = Math.max(50, bgGrid[gy][gx]);
                    const idx = (y * w + x) * 4;
                    const r = d[idx], g = d[idx+1], b = d[idx+2];
                    
                    // For blue/black pen: Red channel is the darkest!
                    const minCh = Math.min(r, g);
                    const lum = 0.299 * r + 0.587 * g + 0.114 * b;
                    const effectiveLum = Math.min(lum, minCh * 1.15);

                    const ratio = effectiveLum / localBg;
                    let enhanced;
                    if (ratio < 0.85) {
                        // Dark & medium ink stroke - push darker with smooth quadratic curve (supports light pencil to heavy marker)
                        const normInk = ratio / 0.85;
                        enhanced = Math.max(0, Math.round(normInk * normInk * 115));
                    } else if (ratio < 0.94) {
                        // Soft edge anti-aliasing transition (fine ballpoint pen & pencil stroke preservation)
                        enhanced = Math.min(255, Math.round(115 + (ratio - 0.85) * 1550));
                    } else {
                        // Paper background - clean bright white
                        enhanced = 255;
                    }

                    d[idx] = enhanced;
                    d[idx+1] = enhanced;
                    d[idx+2] = enhanced;
                }
            }
            ctx.putImageData(imgData, 0, 0);
        } catch (e) {}

        return canvas;
    }

    function analyzeHandwrittenDigitShape(canvas) {
        if (!canvas) return null;
        try {
            const ctx = canvas.getContext('2d', { willReadFrequently: true });
            const w = canvas.width;
            const h = canvas.height;
            const img = ctx.getImageData(0, 0, w, h);
            const data = img.data;

            // Find ink luminance range
            let minLum = 255, maxLum = 0;
            const lumArr = new Uint8Array(w * h);
            for (let i = 0, p = 0; i < data.length; i += 4, p++) {
                const lum = data[i];
                lumArr[p] = lum;
                if (lum < minLum) minLum = lum;
                if (lum > maxLum) maxLum = lum;
            }

            if (maxLum - minLum < 24) return null; // image too flat

            const threshold = minLum + (maxLum - minLum) * 0.48;

            // Find ink bounding box
            let minX = w, maxX = 0, minY = h, maxY = 0;
            let inkCount = 0;
            for (let y = 0; y < h; y++) {
                for (let x = 0; x < w; x++) {
                    if (lumArr[y * w + x] < threshold) {
                        inkCount++;
                        if (x < minX) minX = x;
                        if (x > maxX) maxX = x;
                        if (y < minY) minY = y;
                        if (y > maxY) maxY = y;
                    }
                }
            }

            // Adaptive ink threshold for tiny pencil writing (min 12 px) up to large marker
            if (inkCount < 12 || maxX <= minX || maxY <= minY) return null;

            const boxW = maxX - minX + 1;
            const boxH = maxY - minY + 1;
            const aspectRatio = boxW / boxH;

            // 1. Top Bar test (Top 24% of height)
            let topMinX = w, topMaxX = 0;
            const topLimitY = minY + Math.round(boxH * 0.24);
            for (let y = minY; y <= topLimitY; y++) {
                for (let x = minX; x <= maxX; x++) {
                    if (lumArr[y * w + x] < threshold) {
                        if (x < topMinX) topMinX = x;
                        if (x > topMaxX) topMaxX = x;
                    }
                }
            }
            const topSpan = (topMaxX >= topMinX) ? (topMaxX - topMinX + 1) / boxW : 0;

            // 2. Middle Crossbar test (35% to 65% of height)
            let hasCrossbar = false;
            const midStartY = minY + Math.round(boxH * 0.35);
            const midEndY = minY + Math.round(boxH * 0.65);
            const minCrossbarPixels = Math.max(2, Math.round(boxW * 0.20));
            for (let y = midStartY; y <= midEndY; y++) {
                let rowMinX = w, rowMaxX = 0;
                let rowInk = 0;
                for (let x = minX; x <= maxX; x++) {
                    if (lumArr[y * w + x] < threshold) {
                        rowInk++;
                        if (x < rowMinX) rowMinX = x;
                        if (x > rowMaxX) rowMaxX = x;
                    }
                }
                if (rowMaxX > rowMinX) {
                    const rowSpan = (rowMaxX - rowMinX + 1) / boxW;
                    // Horizontal crossbar across the center (classic European 7, scale-independent)
                    if (rowSpan > 0.38 && rowInk >= minCrossbarPixels) {
                        hasCrossbar = true;
                        break;
                    }
                }
            }

            // European handwritten '7': has crossbar OR (wide top bar and wider aspect ratio)
            // European handwritten '1': narrow vertical stroke, narrow top (topSpan < 0.45), no crossbar
            const isSeven = hasCrossbar || (topSpan > 0.50 && aspectRatio > 0.35);

            return {
                isSeven,
                hasCrossbar,
                topSpan,
                aspectRatio,
                boxW,
                boxH
            };
        } catch (e) {
            return null;
        }
    }

    function damerauLevenshtein(a, b) {
        if (!a || !b) return (a || b || '').length;
        const al = a.length, bl = b.length;
        if (Math.abs(al - bl) > 6) return 99;

        let d = [];
        for (let i = 0; i <= al; i++) {
            d[i] = [i];
        }
        for (let j = 0; j <= bl; j++) {
            d[0][j] = j;
        }

        for (let i = 1; i <= al; i++) {
            for (let j = 1; j <= bl; j++) {
                const cost = a[i - 1] === b[j - 1] ? 0 : 1;
                d[i][j] = Math.min(
                    d[i - 1][j] + 1,
                    d[i][j - 1] + 1,
                    d[i - 1][j - 1] + cost
                );
                if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) {
                    d[i][j] = Math.min(d[i][j], d[i - 2][j - 2] + 1);
                }
            }
        }
        return d[al][bl];
    }

    function ngramSimilarity(s1, s2, n = 3) {
        if (!s1 || !s2) return 0;
        if (s1 === s2) return 1.0;
        if (s1.length < n || s2.length < n) {
            return s1.includes(s2) || s2.includes(s1) ? 0.75 : 0;
        }
        const getNgrams = (s) => {
            const grams = new Map();
            for (let i = 0; i <= s.length - n; i++) {
                const g = s.substr(i, n);
                grams.set(g, (grams.get(g) || 0) + 1);
            }
            return grams;
        };
        const g1 = getNgrams(s1);
        const g2 = getNgrams(s2);
        let intersection = 0;
        for (const [k, v] of g1.entries()) {
            if (g2.has(k)) {
                intersection += Math.min(v, g2.get(k));
            }
        }
        const total = (s1.length - n + 1) + (s2.length - n + 1);
        return (2.0 * intersection) / total;
    }

    function normalizeTextForMatch(str) {
        if (!str) return '';
        return String(str)
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/[^a-z0-9]/g, " ")
            .replace(/\s+/g, " ")
            .trim();
    }

    function normalizeHandwritingOCR(text) {
        if (!text) return '';
        let s = normalizeTextForMatch(text);
        // Replace handwriting confusion characters inside words
        s = s.replace(/([a-z])1([a-z])/g, '$1l$2');
        s = s.replace(/([a-z])2([a-z])/g, '$1z$2');
        s = s.replace(/([a-z])0([a-z])/g, '$1o$2');
        s = s.replace(/([a-z])5([a-z])/g, '$1s$2');
        s = s.replace(/([a-z])8([a-z])/g, '$1b$2');
        s = s.replace(/([a-z])4([a-z])/g, '$1a$2');
        // Word beginnings where digit was OCR'd instead of leading letter
        s = s.replace(/(^|\s)5([a-z]{2,})/g, '$1s$2');
        s = s.replace(/(^|\s)1([a-z]{2,})/g, '$1l$2');
        s = s.replace(/(^|\s)0([a-z]{2,})/g, '$1o$2');
        s = s.replace(/(^|\s)8([a-z]{2,})/g, '$1b$2');
        s = s.replace(/(^|\s)7([a-z]{2,})/g, '$1t$2');
        // Handwriting block letters & endings
        s = s.replace(/([a-z]{2,})1($|\s)/g, '$1l$2');
        s = s.replace(/([a-z]{2,})0($|\s)/g, '$1o$2');
        s = s.replace(/([a-z]{2,})5($|\s)/g, '$1s$2');
        // Common Czech & German handwriting OCR variants
        s = s.replace(/krvtka/g, 'krytka');
        s = s.replace(/dverl/g, 'dveri');
        s = s.replace(/zadnl/g, 'zadni');
        s = s.replace(/prednl/g, 'predni');
        return s;
    }

    function toCompactMatchStr(str) {
        if (!str) return '';
        return normalizeTextForMatch(str).replace(/[^a-z0-9]/g, '');
    }

    function isWholeWordOrPhraseMatch(text, target) {
        if (!text || !target) return false;
        const normT = normalizeTextForMatch(text);
        const normP = normalizeTextForMatch(target);
        if (!normT || !normP) return false;
        if (normT === normP) return true;

        // Word-boundary check: target must be surrounded by word boundaries (spaces/start/end)
        // Prevents false positives where a substring of a compound word is matched (e.g. Deckel inside Steckdeckel)
        const escaped = normP.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const regex = new RegExp('(^|[^a-z0-9])' + escaped + '([^a-z0-9]|$)', 'i');
        return regex.test(normT);
    }

    function matchScannedData(rawOcrText, barcodeValues = [], cropCanvas = null) {
        const activeMolds = rawDatabase.filter(item => !item[4]);
        if (activeMolds.length === 0) return null;

        const ocrStr = String(rawOcrText || '');
        const normOcr = normalizeTextForMatch(ocrStr);
        const hwNormOcr = normalizeHandwritingOCR(ocrStr);

        // Visual check for European handwritten '7' vs '1'
        const glyphAnalysis = analyzeHandwrittenDigitShape(cropCanvas);
        const isVisualSeven = glyphAnalysis ? glyphAnalysis.isSeven : false;

        // 1. Gather all candidate mold numbers (STRICT WHOLE NUMBERS ONLY)
        const rawCandidates = new Set();
        for (const b of barcodeValues) {
            const cleanB = String(b || '').trim();
            if (cleanB && /^\d+([/-]\d+)?$/.test(cleanB)) {
                rawCandidates.add(cleanB);
            }
        }

        // Clean label noise (e.g. "forma: ", "č. ", "no. ", "#", "typ: ") from OCR string
        const cleanedOcrForNums = ocrStr
            .replace(/(forma|číslo|cislo|č\.|no\.|nr\.|#|typ)\s*[:\-_]?\s*/gi, ' ');

        const ocrNumLines = cleanedOcrForNums.split(/\r?\n/).map(l => l.trim()).filter(Boolean);

        const isEuroSevenGlyph = (t) => /^[-+tTF\/?!~\\\]>]$/i.test(t);
        const isEuroOneGlyph = (t) => /^[|Il!1]$/.test(t);

        for (const line of ocrNumLines) {
            // Strip brackets/noise
            const cleanLine = line.replace(/[[\](){}<>#]/g, ' ').replace(/\s+/g, ' ').trim();
            const tokens = cleanLine.split(' ').filter(Boolean);
            if (tokens.length === 0) continue;

            const seq = [];
            for (let i = 0; i < tokens.length; i++) {
                const tok = tokens[i];
                if (/^\d+$/.test(tok)) {
                    seq.push(tok);
                } else if (isEuroSevenGlyph(tok) && i < tokens.length - 1 && /^\d+$/.test(tokens[i + 1])) {
                    seq.push('7');
                } else if (isEuroOneGlyph(tok) && i < tokens.length - 1 && /^\d+$/.test(tokens[i + 1])) {
                    seq.push('1');
                }
            }

            // If spaced digits or glyph + digits formed a candidate number (e.g. "7 6 5", "t 6 5", "+ 6 5", "7 65")
            const lineCombined = [];
            if (seq.length >= 2) {
                const combined = seq.join('');
                if (combined.length >= 2 && combined.length <= 5) {
                    rawCandidates.add(combined);
                    lineCombined.push(combined);
                    if (combined.startsWith('7')) {
                        rawCandidates.add('1' + combined.slice(1));
                    } else if (combined.startsWith('1')) {
                        rawCandidates.add('7' + combined.slice(1));
                    }
                }
            }

            // Check individual tokens on this line (e.g. "765", "050", "050C", "C050", "1002")
            for (const tok of tokens) {
                if (/^\d{2,5}$/.test(tok)) {
                    // ANTI-CHUNK: If tok is a strict substring of a longer number created from this line (e.g. '65' from '765'),
                    // NEVER add it as an isolated candidate!
                    const isSub = lineCombined.some(c => c !== tok && c.includes(tok));
                    if (!isSub) {
                        rawCandidates.add(tok);
                    }
                } else {
                    // Check if token itself had Euro-7 prefix like "T65", "+65", "/65", "-65"
                    const prefixMatch = tok.match(/^[-+tTF\/?!~\\\]>](\d{2,4})$/i);
                    if (prefixMatch) {
                        const fullNum = '7' + prefixMatch[1];
                        rawCandidates.add(fullNum);
                        rawCandidates.add('1' + prefixMatch[1]);
                    }
                    // Check if token has numbers attached to letters/zone identifiers (e.g. "050C", "050-C", "C050")
                    const embeddedMatches = tok.match(/\d{2,5}/g) || [];
                    for (const em of embeddedMatches) {
                        const isSub = lineCombined.some(c => c !== em && c.includes(em));
                        if (!isSub) {
                            rawCandidates.add(em);
                        }
                    }
                }
            }
        }

        // Apply visual glyph analysis permutations
        if (isVisualSeven) {
            const extra = [];
            for (const c of rawCandidates) {
                if (c.includes('1')) extra.push(c.replace(/1/g, '7'));
            }
            extra.forEach(e => rawCandidates.add(e));
        }

        // STRICT WHOLE NUMBER SORTING: Longest candidates first!
        // 3-digit and 4-digit candidates (like "765", "165") MUST be tested BEFORE shorter 2-digit ones!
        const candNumbers = Array.from(rawCandidates).sort((a, b) => b.length - a.length || b.localeCompare(a));

        // Check if any candidate number directly corresponds to a mold in DB (STRICT WHOLE NUMBER EQUALITY)
        let directMold = null;
        for (const cand of candNumbers) {
            const cleanCand = cand.trim();
            if (!cleanCand) continue;

            directMold = activeMolds.find(m => {
                const mId = String(m[0]).trim();
                if (mId === cleanCand) return true;
                if (/^\d+$/.test(cleanCand) && /^\d+$/.test(mId)) {
                    const sc = cleanCand.replace(/^0+/, '') || '0';
                    const sm = mId.replace(/^0+/, '') || '0';
                    return sc === sm;
                }
                return false;
            });
            if (directMold) break;
        }

        // 2. Check for product / item name matches with strict compound & whole-word coverage
        const rawLines = ocrStr.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
        const prefixRegex = /^(výrobek|vyrobek|výroba|vyroba|díl|dil|název|nazev|artikl|položka|polozka|model|popis|part|product|name|forma|typ)[:\s\-_]+/i;
        
        const cleanedLinesNorm = rawLines.map(l => {
            const stripped = l.replace(prefixRegex, '').trim();
            return normalizeTextForMatch(stripped);
        }).filter(l => l.length >= 2);

        const cleanedLinesHwNorm = rawLines.map(l => {
            const stripped = l.replace(prefixRegex, '').trim();
            return normalizeHandwritingOCR(stripped);
        }).filter(l => l.length >= 2);

        // Compact forms without spaces or punctuation (e.g. "S T E C K D E C K E L" -> "steckdeckel")
        const toCompact = (s) => normalizeTextForMatch(s).replace(/[^a-z0-9]/g, '');
        const compactOcr = toCompact(ocrStr);
        const compactHwOcr = toCompact(hwNormOcr);
        const linesCompact = [...cleanedLinesNorm, ...cleanedLinesHwNorm].map(l => toCompact(l)).filter(l => l.length >= 2);

        // Group molds by normalized product name
        const productGroups = new Map();
        for (const mold of activeMolds) {
            const rawProd = String(mold[5] || '').trim();
            if (!rawProd || rawProd.length < 2) continue;
            const normProd = normalizeTextForMatch(rawProd);
            if (!normProd || normProd.length < 2) continue;
            const compactProd = toCompact(rawProd);

            if (!productGroups.has(normProd)) {
                productGroups.set(normProd, { origName: rawProd, normName: normProd, compactName: compactProd, molds: [] });
            }
            if (!productGroups.get(normProd).molds.some(m => String(m[0]) === String(mold[0]))) {
                productGroups.get(normProd).molds.push(mold);
            }
        }

        // Match detected text against product groups using strict whole-word and compound matching
        let matchedGroups = [];
        for (const [normProd, group] of productGroups.entries()) {
            const compactProd = group.compactName;
            if (!compactProd || compactProd.length < 2) continue;
            let matchScore = 0;

            // Check each line's compact string
            for (const compactLine of linesCompact) {
                // A. EXACT COMPACT MATCH (e.g. OCR "S T E C K D E C K E L" or "Steck deckel" -> "steckdeckel" === DB product "Steckdeckel")
                if (compactLine === compactProd) {
                    matchScore = Math.max(matchScore, 500 + compactProd.length * 2);
                    continue;
                }

                // B. Substring inside line with Anti-Chunk protection
                if (compactLine.includes(compactProd)) {
                    const idx = compactLine.indexOf(compactProd);
                    const prefix = compactLine.slice(0, idx);
                    const suffix = compactLine.slice(idx + compactProd.length);
                    // If line has significant unassigned letters (>= 3 chars) before or after,
                    // it is a chunk (e.g. "Deckel" inside "Steckdeckel" has prefix "steck")!
                    // Strict Anti-Chunk rule: penalize chunk so it cannot steal match!
                    if (prefix.length >= 3 || suffix.length >= 3) {
                        matchScore = Math.max(matchScore, 40);
                    } else {
                        matchScore = Math.max(matchScore, 400 + compactProd.length);
                    }
                    continue;
                }

                // C. Fuzzy match for handwriting character confusions (e.g. 'd' misread as 'o', 'l' as '1', 's' as '5')
                if (compactLine.length >= 4 && compactProd.length >= 4) {
                    const lenDiff = Math.abs(compactLine.length - compactProd.length);
                    if (lenDiff <= 2) {
                        const dist = damerauLevenshtein(compactLine, compactProd);
                        const maxDist = compactProd.length >= 8 ? 2 : 1;
                        if (dist <= maxDist) {
                            matchScore = Math.max(matchScore, 350 - dist * 40);
                        }
                    } else if (compactLine.length > compactProd.length) {
                        // Sliding window search inside longer compact line
                        for (let i = 0; i <= compactLine.length - compactProd.length; i++) {
                            const sub = compactLine.substr(i, compactProd.length);
                            const dist = damerauLevenshtein(sub, compactProd);
                            if (dist <= 1) {
                                const prefix = compactLine.slice(0, i);
                                const suffix = compactLine.slice(i + compactProd.length);
                                if (prefix.length >= 3 || suffix.length >= 3) {
                                    matchScore = Math.max(matchScore, 40);
                                } else {
                                    matchScore = Math.max(matchScore, 320 - dist * 40);
                                }
                            }
                        }
                    }
                }
            }

            // D. Whole line match with spaces
            if (matchScore < 200) {
                if (cleanedLinesNorm.some(cl => cl === normProd) || cleanedLinesHwNorm.some(cl => cl === normProd)) {
                    matchScore = Math.max(matchScore, 250 + normProd.length);
                } else if (
                    cleanedLinesNorm.some(cl => isWholeWordOrPhraseMatch(cl, normProd)) ||
                    cleanedLinesHwNorm.some(cl => isWholeWordOrPhraseMatch(cl, normProd))
                ) {
                    const matchingLine = cleanedLinesNorm.find(cl => isWholeWordOrPhraseMatch(cl, normProd)) ||
                                         cleanedLinesHwNorm.find(cl => isWholeWordOrPhraseMatch(cl, normProd));
                    const lineWords = matchingLine.split(' ').filter(w => w.length >= 2);
                    const prodWords = normProd.split(' ').filter(w => w.length >= 2);
                    const unassignedWords = lineWords.filter(lw => !prodWords.includes(lw));

                    if (unassignedWords.some(w => w.length >= 3)) {
                        matchScore = Math.max(matchScore, 40);
                    } else {
                        matchScore = Math.max(matchScore, 180 + normProd.length);
                    }
                }
            }

            // E. Compact OCR global check (with Anti-Chunk)
            if (matchScore < 100) {
                for (const fullC of [compactOcr, compactHwOcr]) {
                    if (fullC.includes(compactProd)) {
                        const idx = fullC.indexOf(compactProd);
                        const prefix = fullC.slice(0, idx);
                        const suffix = fullC.slice(idx + compactProd.length);
                        if (prefix.length >= 3 || suffix.length >= 3) {
                            matchScore = Math.max(matchScore, 40);
                        } else {
                            matchScore = Math.max(matchScore, 150);
                        }
                    }
                }
            }

            if (matchScore >= 120) {
                matchedGroups.push({ group, score: matchScore, normProd, compactProd });
            }
        }

        if (matchedGroups.length > 0) {
            matchedGroups.sort((a, b) => b.score - a.score);
            const best = matchedGroups[0].group;
            const bestScore = matchedGroups[0].score;

            // If a specific mold number was also found on the plan/sheet and matches this group, open that specific mold
            if (directMold && best.molds.some(m => String(m[0]) === String(directMold[0]))) {
                return {
                    type: 'single',
                    mold: directMold,
                    matchType: 'exact_mold_in_product',
                    productName: best.origName
                };
            }

            // If product match is very high confidence (score >= 200, like "Steckdeckel"):
            // The product match takes precedence over an unrelated single mold number (e.g. 765)
            if (bestScore >= 200 || !directMold) {
                if (best.molds.length === 1) {
                    return {
                        type: 'single',
                        mold: best.molds[0],
                        matchType: 'unique_product',
                        productName: best.origName
                    };
                } else {
                    return {
                        type: 'multi',
                        molds: best.molds,
                        matchType: 'multi_product',
                        productName: best.origName
                    };
                }
            }
        }

        // 3. Fallback to direct mold ID match if no product name matched
        if (directMold) {
            return {
                type: 'single',
                mold: directMold,
                matchType: 'direct_id',
                productName: directMold[5] || ''
            };
        }

        return null;
    }

    function findFuzzyOrDisambiguatedMold(candidateStr, activeMolds) {
        if (!candidateStr || !Array.isArray(activeMolds) || activeMolds.length === 0) return null;
        const raw = String(candidateStr).trim();
        if (!raw) return null;

        // 1. Direct exact check
        let found = activeMolds.find(m => String(m[0]).trim() === raw);
        if (found) return { mold: found, isAutoCorrected: false, orig: raw };

        // 2. Leading zero normalization (e.g. 000584, 00584, 0584 -> 584, 050 -> 50)
        if (/^\d+$/.test(raw)) {
            const strippedZero = raw.replace(/^0+/, '') || '0';
            if (strippedZero !== raw) {
                found = activeMolds.find(m => {
                    const mId = String(m[0]).trim();
                    return mId === strippedZero || (/^\d+$/.test(mId) && (mId.replace(/^0+/, '') || '0') === strippedZero);
                });
                if (found) return { mold: found, isAutoCorrected: true, orig: raw, fixed: String(found[0]) };
            }
        }

        // 3. Embedded numeric token extraction if string contains adjacent letters/suffixes (e.g. "050 C", "050-C", "F-050", "poz. 0584")
        const embeddedNumMatch = raw.match(/\b\d{2,6}\b/) || raw.match(/\d{2,6}/);
        if (embeddedNumMatch) {
            const extractedNum = embeddedNumMatch[0];
            const strippedExtracted = extractedNum.replace(/^0+/, '') || '0';
            found = activeMolds.find(m => {
                const mId = String(m[0]).trim();
                return mId === extractedNum || mId === strippedExtracted || (/^\d+$/.test(mId) && (mId.replace(/^0+/, '') || '0') === strippedExtracted);
            });
            if (found) return { mold: found, isAutoCorrected: true, orig: raw, fixed: String(found[0]) };
        }

        // 4. Optical character substitution (common OCR confusions on handwriting)
        // O/D -> 0, S -> 5, I/l/| -> 1, B -> 8, Z -> 2
        let fixed = raw
            .replace(/[oOdD]/g, '0')
            .replace(/[sS]/g, '5')
            .replace(/[Il|!]/g, '1')
            .replace(/[bB]/g, '8')
            .replace(/[zZ]/g, '2');
        
        found = activeMolds.find(m => String(m[0]).trim() === fixed);
        if (found) return { mold: found, isAutoCorrected: true, orig: raw, fixed };

        // Leading zero normalization after OCR character substitution (e.g. "O584" -> "0584" -> "584", "O5O" -> "050" -> "50")
        if (/^\d+$/.test(fixed)) {
            const strippedFixed = fixed.replace(/^0+/, '') || '0';
            if (strippedFixed !== fixed) {
                found = activeMolds.find(m => {
                    const mId = String(m[0]).trim();
                    return mId === strippedFixed || (/^\d+$/.test(mId) && (mId.replace(/^0+/, '') || '0') === strippedFixed);
                });
                if (found) return { mold: found, isAutoCorrected: true, orig: raw, fixed: String(found[0]) };
            }
        }

        // Embedded numbers in fixed string
        const fixedEmbedded = fixed.match(/\b\d{2,6}\b/) || fixed.match(/\d{2,6}/);
        if (fixedEmbedded) {
            const extFixed = fixedEmbedded[0];
            const strippedExtFixed = extFixed.replace(/^0+/, '') || '0';
            found = activeMolds.find(m => {
                const mId = String(m[0]).trim();
                return mId === extFixed || mId === strippedExtFixed || (/^\d+$/.test(mId) && (mId.replace(/^0+/, '') || '0') === strippedExtFixed);
            });
            if (found) return { mold: found, isAutoCorrected: true, orig: raw, fixed: String(found[0]) };
        }

        // 5. Levenshtein edit distance = 1 for numeric codes of length >= 3
        if (/^\d{3,6}$/.test(raw) || /^\d{3,6}$/.test(fixed)) {
            const checkNum = /^\d+$/.test(raw) ? raw : fixed;
            const singleDistanceMatches = activeMolds.filter(m => {
                const moldId = String(m[0]).trim();
                return /^\d+$/.test(moldId) && damerauLevenshtein(checkNum, moldId) === 1;
            });
            // Only accept if exactly 1 unambiguous match
            if (singleDistanceMatches.length === 1) {
                return { mold: singleDistanceMatches[0], isAutoCorrected: true, orig: raw, fixed: String(singleDistanceMatches[0][0]) };
            }
        }

        return null;
    }

    function matchGeminiData(geminiResult, barcodeValues = [], cropCanvas = null) {
        if (!geminiResult || geminiResult.error) return null;
        const activeMolds = rawDatabase.filter(item => !item[4]);
        if (activeMolds.length === 0) return null;

        if (geminiResult.primaryNumber) {
            const match = findFuzzyOrDisambiguatedMold(geminiResult.primaryNumber, activeMolds);
            if (match && match.mold) {
                return {
                    type: 'single',
                    mold: match.mold,
                    matchType: match.isAutoCorrected ? 'auto_corrected_id' : 'direct_id',
                    productName: match.mold[5] || '',
                    autoCorrectedFrom: match.isAutoCorrected ? match.orig : null
                };
            }
        }

        if (Array.isArray(geminiResult.numbers)) {
            for (const numStr of geminiResult.numbers) {
                const match = findFuzzyOrDisambiguatedMold(numStr, activeMolds);
                if (match && match.mold) {
                    return {
                        type: 'single',
                        mold: match.mold,
                        matchType: match.isAutoCorrected ? 'auto_corrected_id' : 'direct_id',
                        productName: match.mold[5] || '',
                        autoCorrectedFrom: match.isAutoCorrected ? match.orig : null
                    };
                }
            }
        }

        const textParts = [];
        if (geminiResult.primaryNumber) textParts.push(geminiResult.primaryNumber);
        if (Array.isArray(geminiResult.numbers)) textParts.push(...geminiResult.numbers);
        if (geminiResult.productName) textParts.push(geminiResult.productName);
        if (geminiResult.rawText) textParts.push(geminiResult.rawText);

        const combinedText = textParts.filter(Boolean).join('\n');
        return matchScannedData(combinedText, barcodeValues, cropCanvas);
    }

    function matchGeminiPlanBatch(geminiResult, barcodeValues = [], cropCanvas = null) {
        if (!geminiResult || geminiResult.error) return [];
        const activeMolds = rawDatabase.filter(item => !item[4]);
        if (activeMolds.length === 0) return [];

        const foundMoldsMap = new Map();
        const machineUsedSet = new Set();

        // 0. Structured pairs matching [Machine Number - Mold Number]
        if (geminiResult && Array.isArray(geminiResult.pairs) && geminiResult.pairs.length > 0) {
            for (const pair of geminiResult.pairs) {
                if (!pair || !pair.mold) continue;
                const moldStr = String(pair.mold).trim();
                const machineStr = String(pair.machine || '').trim();

                const match = findFuzzyOrDisambiguatedMold(moldStr, activeMolds);
                if (match && match.mold) {
                    const idStr = String(match.mold[0]);
                    if (!foundMoldsMap.has(idStr)) {
                        const moldItem = [...match.mold];
                        if (machineStr && isWorkshopMachine(machineStr)) {
                            moldItem._machine = machineStr;
                            machineUsedSet.add(machineStr);
                        }
                        foundMoldsMap.set(idStr, moldItem);
                    }
                }
            }
        }

        // 1. Direct / Fuzzy match from geminiResult.numbers array
        if (geminiResult && Array.isArray(geminiResult.numbers)) {
            for (const numStr of geminiResult.numbers) {
                const cleanNum = String(numStr).trim();
                if (machineUsedSet.has(cleanNum)) continue;

                const match = findFuzzyOrDisambiguatedMold(cleanNum, activeMolds);
                if (match && match.mold && !foundMoldsMap.has(String(match.mold[0]))) {
                    foundMoldsMap.set(String(match.mold[0]), match.mold);
                }
            }
        }

        // 2. Direct / Fuzzy match from geminiResult.primaryNumber if present
        if (geminiResult && geminiResult.primaryNumber) {
            const cleanNum = String(geminiResult.primaryNumber).trim();
            if (!machineUsedSet.has(cleanNum)) {
                const match = findFuzzyOrDisambiguatedMold(cleanNum, activeMolds);
                if (match && match.mold && !foundMoldsMap.has(String(match.mold[0]))) {
                    foundMoldsMap.set(String(match.mold[0]), match.mold);
                }
            }
        }

        // 3. Optional secondary check for product names (only if explicit product name exists or no molds matched yet)
        if (foundMoldsMap.size === 0) {
            const textParts = [];
            if (geminiResult.productName) textParts.push(geminiResult.productName);
            if (geminiResult.rawText) textParts.push(geminiResult.rawText);

            const combinedText = textParts.filter(Boolean).join('\n');
            const secondaryMatches = matchScannedPlanBatch(combinedText, barcodeValues, cropCanvas);
            if (Array.isArray(secondaryMatches)) {
                secondaryMatches.forEach(mold => {
                    if (mold && !foundMoldsMap.has(String(mold[0]))) {
                        foundMoldsMap.set(String(mold[0]), mold);
                    }
                });
            }
        } else if (geminiResult.productName) {
            // If mold numbers were already recognized with high confidence, only check explicit product name without mutating numbers
            const prodMatches = matchScannedPlanBatch(geminiResult.productName, barcodeValues, cropCanvas);
            if (Array.isArray(prodMatches)) {
                prodMatches.forEach(mold => {
                    if (mold && !foundMoldsMap.has(String(mold[0]))) {
                        foundMoldsMap.set(String(mold[0]), mold);
                    }
                });
            }
        }

        return Array.from(foundMoldsMap.values());
    }

    function matchScannedPlanBatch(rawOcrText, barcodeValues = [], cropCanvas = null) {
        const activeMolds = rawDatabase.filter(item => !item[4]);
        if (activeMolds.length === 0) return [];

        const ocrStr = String(rawOcrText || '');
        const foundMoldsMap = new Map();

        // 1. Check all barcode values
        for (const b of barcodeValues) {
            const cleanB = String(b || '').trim();
            if (cleanB) {
                const mold = activeMolds.find(m => String(m[0]).trim() === cleanB);
                if (mold && !foundMoldsMap.has(String(mold[0]))) {
                    foundMoldsMap.set(String(mold[0]), mold);
                }
            }
        }

        // 2. Strip timestamps (e.g. 14:26:00), dates (e.g. 28.09.2024), header noise words
        const cleanedOcr = ocrStr
            .replace(/\b\d{1,2}[./\-]\d{1,2}[./\-]\d{2,4}\b/g, ' ')
            .replace(/\b\d{1,2}:\d{2}(:\d{2})?\b/g, ' ')
            .replace(/\b(datum|smena|směna|pl[aá]n|forma|list|v[yý]roba)\b/gi, ' ');

        // Visual check for European handwritten '7'
        const glyphAnalysis = analyzeHandwrittenDigitShape(cropCanvas);
        const isVisualSeven = glyphAnalysis ? glyphAnalysis.isSeven : false;

        const candidateNumbers = new Set();
        const candidateConfidence = new Map();

        function addCandidate(cand, isDirect = false) {
            const clean = String(cand || '').trim();
            if (!clean || clean.length < 2 || clean.length > 5) return;
            candidateNumbers.add(clean);
            candidateConfidence.set(clean, (candidateConfidence.get(clean) || 0) + (isDirect ? 2 : 1));
        }

        // Split cleaned OCR by lines to preserve row structure
        const rawLines = cleanedOcr.split(/\r?\n/).map(l => l.trim()).filter(Boolean);

        for (const line of rawLines) {
            // Check for digit sequences with spaces between digits (e.g. "7 6 5", "7 64", "8 0 8")
            const spacedMatches = line.match(/\b\d(?:\s+\d){1,4}\b/g) || [];
            for (const sm of spacedMatches) {
                const joined = sm.replace(/\s+/g, '');
                if (joined.length >= 2 && joined.length <= 5) {
                    addCandidate(joined, true);
                }
            }

            // Also check direct digit tokens
            const digitMatches = line.match(/\b\d{2,5}\b/g) || [];
            for (const dm of digitMatches) {
                addCandidate(dm, true);
            }

            // Tokenize line for alphanumeric / handwritten tokens
            const tokens = line.replace(/[[\](){}<>#]/g, ' ').split(/[\s,;:|\/\t]+/).filter(Boolean);
            for (const tok of tokens) {
                // Generate handwriting variations (7 crossbar, B/8/6, O/0, I/1, Z/2, S/5, etc.)
                const variations = generateHandwritingVariations(tok);
                for (const v of variations) {
                    addCandidate(v, false);
                }
            }
        }

        if (isVisualSeven) {
            const extra = [];
            for (const c of candidateNumbers) {
                if (c.includes('1')) extra.push(c.replace(/1/g, '7'));
            }
            extra.forEach(e => addCandidate(e, false));
        }

        // Helper: handwriting variations generator
        function generateHandwritingVariations(tok) {
            const list = new Set();
            const str = String(tok).trim();
            if (!str || str.length < 2 || str.length > 6) return [];

            // Primary handwriting letter substitutions:
            let v1 = str
                .replace(/[oOD]/g, '0')
                .replace(/[lI!|]/g, '1')
                .replace(/[zZ]/g, '2')
                .replace(/[sS]/g, '5')
                .replace(/[bB]/g, '8')
                .replace(/[gq]/g, '9')
                .replace(/[-+tTF\/?!~\\\]>]/g, '7');

            if (/^\d{2,5}$/.test(v1)) list.add(v1);

            let v2 = str
                .replace(/[oOD]/g, '0')
                .replace(/[lI!|]/g, '1')
                .replace(/[zZ]/g, '2')
                .replace(/[sS]/g, '5')
                .replace(/[bB]/g, '6')
                .replace(/[gq]/g, '9')
                .replace(/[-+tTF\/?!~\\\]>]/g, '7');

            if (/^\d{2,5}$/.test(v2)) list.add(v2);

            // European '7' with crossbar (often misrecognized as '4' or '1' by OCR engines)
            const currentArr = Array.from(list);
            if (/^\d{3,4}$/.test(str)) currentArr.push(str);

            for (const num of currentArr) {
                if (num.length >= 3 && num.length <= 4) {
                    // If OCR read '4' instead of '7' with crossbar (e.g. 465 -> 765): test with 7
                    if (num.startsWith('4')) list.add('7' + num.slice(1));
                    // If OCR read '1' instead of '7' with crossbar (e.g. 165 -> 765): test with 7 only for fallback
                    if (num.startsWith('1')) list.add('7' + num.slice(1));
                }
            }

            return Array.from(list);
        }

        // 3. Match against database molds
        // Sort candidate numbers: prefer longer candidates (3-4 digits) over short 2-digit ones
        const sortedCandidates = Array.from(candidateNumbers).sort((a, b) => {
            if (b.length !== a.length) return b.length - a.length;
            return (candidateConfidence.get(b) || 0) - (candidateConfidence.get(a) || 0);
        });

        // Anti-noise filter for 2-digit numbers:
        let hasLongMolds = false;

        for (const cand of sortedCandidates) {
            if (cand.length >= 3) {
                const mold = activeMolds.find(m => {
                    const mId = String(m[0]).trim();
                    if (mId === cand) return true;
                    if (/^\d+$/.test(cand) && /^\d+$/.test(mId)) {
                        return (cand.replace(/^0+/, '') || '0') === (mId.replace(/^0+/, '') || '0');
                    }
                    return false;
                });
                if (mold && !foundMoldsMap.has(String(mold[0]))) {
                    foundMoldsMap.set(String(mold[0]), mold);
                    hasLongMolds = true;
                }
            }
        }

        // Process 2-digit candidates only if no long molds were found or if cand was a genuine standalone token
        for (const cand of sortedCandidates) {
            if (cand.length === 2) {
                // If we already have 3-digit forms from the sheet, reject stray 2-digit noise (like 26)
                if (hasLongMolds) continue;

                const isIsolated = new RegExp(`(^|\\s)#?${cand}(\\s|$)`).test(cleanedOcr);
                if (isIsolated) {
                    const mold = activeMolds.find(m => {
                        const mId = String(m[0]).trim();
                        if (mId === cand) return true;
                        if (/^\d+$/.test(cand) && /^\d+$/.test(mId)) {
                            return (cand.replace(/^0+/, '') || '0') === (mId.replace(/^0+/, '') || '0');
                        }
                        return false;
                    });
                    if (mold && !foundMoldsMap.has(String(mold[0]))) {
                        foundMoldsMap.set(String(mold[0]), mold);
                    }
                }
            }
        }

        return Array.from(foundMoldsMap.values());
    }

    async function scanVideoFrame() {
        if (isScannerLocked) return;
        if (isScannerProcessing) return;
        isScannerProcessing = true;

        updateScannerSnapBtnState(true, "🧠 Gemini AI...");
        const statusText = document.getElementById('scannerStatusText');
        if (statusText) {
            statusText.textContent = (scannerActiveMode === 'plan')
                ? "🧠 Gemini Vision AI čte plán výroby..."
                : "🧠 Gemini Vision AI čte štítek formy...";
        }

        try {
            const cropCanvas = getCroppedReticleCanvas();
            if (!cropCanvas) {
                showToast("Kamera se ještě načítá. Zkuste za okamžik znovu.");
                if (statusText) statusText.textContent = "Kamera není připravena. Zkuste znovu.";
                return;
            }

            let barcodeValues = [];
            let detectedText = '';

            // ==========================================
            // ON-DEMAND PHOTO RECOGNITION PIPELINE
            // Tier 1 Priority: Gemini Vision AI (Instant recognition & open)
            // Tier 2 Fallback: Barcode + Tesseract OCR (STRICTLY ONLY on Gemini error / offline / quota limit / no key)
            // ==========================================
            const apiKey = getGeminiApiKey();
            let geminiProblem = false;
            let geminiErrorMessage = '';

            if (apiKey) {
                const geminiResult = await recognizeWithGeminiVision(cropCanvas, scannerActiveMode);

                if (geminiResult && geminiResult.error) {
                    // Actual Gemini failure / problem
                    geminiProblem = true;
                    geminiErrorMessage = (geminiResult.error === 'quota_exceeded')
                        ? "Limit Gemini AI vyčerpán"
                        : "Chyba připojení k Gemini AI";
                    console.warn("Gemini Vision selhalo, spouštím záložní OCR:", geminiResult);
                } else if (geminiResult) {
                    // Gemini Vision processed the image successfully:
                    // Under no circumstances do we call Tesseract here!
                    if (scannerActiveMode === 'plan') {
                        const batchMolds = matchGeminiPlanBatch(geminiResult, barcodeValues, cropCanvas);
                        if (batchMolds && batchMolds.length > 0) {
                            handleBatchMoldMatchFound(batchMolds);
                            return;
                        } else {
                            showToast("Gemini AI: Na listu nebyly nalezeny žádné formy z databáze.");
                            if (statusText) statusText.textContent = "Žádné formy nerozpoznány.";
                            playScannerAudioBeep(false);
                            return;
                        }
                    } else {
                        const matchResult = matchGeminiData(geminiResult, barcodeValues, cropCanvas);
                        if (matchResult) {
                            if (matchResult.type === 'single') {
                                const moldNum = matchResult.mold[0];
                                haptic.cameraSuccess();
                                playScannerAudioBeep(true);
                                showToast(`✓ Gemini AI: Forma #${moldNum} nalezena`);
                                scannerOpenSpecificMold(moldNum);
                                return;
                            } else if (matchResult.type === 'multi') {
                                handleMultiMoldMatchFound(matchResult);
                                return;
                            }
                        } else {
                            // Gemini Vision successfully read the frame, but no matching mold exists in the database
                            const sampleFound = (geminiResult.primaryNumber || (geminiResult.numbers && geminiResult.numbers[0]) || geminiResult.productName || geminiResult.rawText || '').trim();
                            if (sampleFound) {
                                const previewText = sampleFound.length > 28 ? sampleFound.substring(0, 28) + '...' : sampleFound;
                                showToast(`Gemini AI přečetlo: "${previewText}", ale v databázi nebyla nalezena shoda.`);
                                if (statusText) statusText.textContent = `Nenalezeno v databázi: "${previewText}"`;
                            } else {
                                showToast("Gemini AI: Na štítku nebylo nalezeno žádné čitelné číslo.");
                                if (statusText) statusText.textContent = "Nerozpoznáno. Zkuste zaostřit.";
                            }
                            playScannerAudioBeep(false);
                            return; // Gemini worked, do NOT start Tesseract!
                        }
                    }
                }
            } else {
                geminiProblem = true;
                geminiErrorMessage = "Klíč Gemini AI není nastaven";
            }

            // ==========================================
            // TIER 2 FALLBACK: ONLY REACHED ON ACTUAL GEMINI PROBLEM
            // (No API key, quota limit, network outage, or API crash)
            // ==========================================
            if (geminiProblem) {
                showToast(`${geminiErrorMessage}. Spouštím záložní OCR...`, 3200);
                if (statusText) statusText.textContent = "Záložní čtení (Kód / OCR)...";
                updateScannerSnapBtnState(true, "Záložní OCR...");

                // 1. Fallback: Barcode / QR detector
                if (scannerBarcodeDetector) {
                    try {
                        const barcodes = await scannerBarcodeDetector.detect(cropCanvas);
                        if (barcodes && barcodes.length > 0) {
                            for (const b of barcodes) {
                                const val = (b.rawValue || '').trim();
                                if (val) barcodeValues.push(val);
                            }
                        }
                    } catch (bErr) {}
                }

                // 2. Fallback: Local Tesseract worker (strictly lazy loaded on demand)
                const worker = await getTesseractWorker();
                if (worker) {
                    try {
                        const desiredPsm = (scannerActiveMode === 'plan') ? '6' : '11';
                        if (scannerCurrentPsm !== desiredPsm) {
                            await worker.setParameters({ tessedit_pageseg_mode: desiredPsm });
                            scannerCurrentPsm = desiredPsm;
                        }

                        const ret = await worker.recognize(cropCanvas);
                        if (ret && ret.data && ret.data.text) {
                            detectedText = ret.data.text.trim();
                        }

                        // Extra slice pass in plan mode if tall
                        if (scannerActiveMode === 'plan' && cropCanvas.height > 350) {
                            try {
                                const halfH = Math.floor(cropCanvas.height / 2);
                                const topCanvas = document.createElement('canvas');
                                topCanvas.width = cropCanvas.width;
                                topCanvas.height = halfH + 40;
                                const topCtx = topCanvas.getContext('2d');
                                topCtx.drawImage(cropCanvas, 0, 0, cropCanvas.width, halfH + 40, 0, 0, topCanvas.width, halfH + 40);

                                const botCanvas = document.createElement('canvas');
                                botCanvas.width = cropCanvas.width;
                                botCanvas.height = halfH + 40;
                                const botCtx = botCanvas.getContext('2d');
                                botCtx.drawImage(cropCanvas, 0, halfH - 40, cropCanvas.width, halfH + 40, 0, 0, botCanvas.width, halfH + 40);

                                const [topRet, botRet] = await Promise.all([
                                    worker.recognize(topCanvas),
                                    worker.recognize(botCanvas)
                                ]);
                                if (topRet?.data?.text) detectedText += '\n' + topRet.data.text;
                                if (botRet?.data?.text) detectedText += '\n' + botRet.data.text;
                            } catch (sliceErr) {
                                console.warn("Slice OCR error:", sliceErr);
                            }
                        }
                    } catch (ocrErr) {
                        console.warn("Chyba záložního OCR:", ocrErr);
                    }
                }

                // Evaluate fallback result
                if (scannerActiveMode === 'plan') {
                    const batchMolds = matchScannedPlanBatch(detectedText, barcodeValues, cropCanvas);
                    if (batchMolds && batchMolds.length > 0) {
                        handleBatchMoldMatchFound(batchMolds);
                        return;
                    } else {
                        showToast("Na listu nebyly nalezeny žádné formy z databáze.");
                        if (statusText) statusText.textContent = "Žádné formy nerozpoznány. Zkuste přiblížit.";
                        playScannerAudioBeep(false);
                        return;
                    }
                } else {
                    const matchResult = matchScannedData(detectedText, barcodeValues, cropCanvas);
                    if (matchResult) {
                        if (matchResult.type === 'single') {
                            const moldNum = matchResult.mold[0];
                            haptic.cameraSuccess();
                            playScannerAudioBeep(true);
                            showToast(`✓ Záložní OCR: Forma #${moldNum} nalezena`);
                            scannerOpenSpecificMold(moldNum);
                            return;
                        } else if (matchResult.type === 'multi') {
                            handleMultiMoldMatchFound(matchResult);
                            return;
                        }
                    } else {
                        const sampleFound = (barcodeValues[0] || detectedText || '').trim().replace(/\s+/g, ' ');
                        if (sampleFound) {
                            const previewText = sampleFound.length > 28 ? sampleFound.substring(0, 28) + '...' : sampleFound;
                            showToast(`Rozpoznáno: "${previewText}", ale v databázi nebyla nalezena shoda.`);
                            if (statusText) statusText.textContent = `Nenalezeno v databázi: "${previewText}"`;
                        } else {
                            showToast("Text ani číslo se nepodařilo rozpoznat. Zkuste zaostřit nebo použít svítilnu.");
                            if (statusText) statusText.textContent = "Nerozpoznáno. Zkuste zaostřit.";
                        }
                        playScannerAudioBeep(false);
                        return;
                    }
                }
            }
        } catch (e) {
            console.error("Chyba při rozpoznávání snímku:", e);
        } finally {
            isScannerProcessing = false;
            updateScannerSnapBtnState(false);
        }
    }

