    function sanitizeGeminiApiKey(raw) {
        if (!raw) return '';
        let str = String(raw).trim();
        // If user pasted multi-line text (e.g. copied UI blocks with titles and status)
        if (str.includes('\n') || str.includes('\r') || str.includes(' ')) {
            const tokens = str.split(/[\s\r\n]+/);
            const candidate = tokens.find(t => t.startsWith('AIzaSy') || t.startsWith('AQ.') || t.startsWith('ya29.') || (t.length >= 20 && /^[A-Za-z0-9_\.-]+$/.test(t)));
            if (candidate) return candidate;
        }
        return str;
    }

    function getGeminiApiKey() {
        try {
            const raw = localStorage.getItem('gemini_api_key') || '';
            return sanitizeGeminiApiKey(raw);
        } catch (e) {
            return '';
        }
    }

    async function fetchGeminiApi(endpointUrl, cleanKey, options = {}) {
        if (!cleanKey) throw new Error("API klíč je prázdný");
        
        const attempts = [];

        // OAuth Bearer tokens (e.g. AQ.Ab8... or ya29....)
        if (cleanKey.startsWith('AQ.') || cleanKey.startsWith('ya29.') || !cleanKey.startsWith('AIzaSy')) {
            attempts.push({
                url: endpointUrl,
                opts: {
                    ...options,
                    headers: { ...(options.headers || {}), 'Authorization': `Bearer ${cleanKey}` }
                }
            });
            attempts.push({
                url: endpointUrl,
                opts: {
                    ...options,
                    headers: { ...(options.headers || {}), 'X-Goog-Api-Key': cleanKey }
                }
            });
            const urlWithKey = endpointUrl.includes('?') 
                ? `${endpointUrl}&key=${encodeURIComponent(cleanKey)}` 
                : `${endpointUrl}?key=${encodeURIComponent(cleanKey)}`;
            attempts.push({ url: urlWithKey, opts: options });
        } else {
            // Standard AIzaSy API key
            const urlWithKey = endpointUrl.includes('?') 
                ? `${endpointUrl}&key=${encodeURIComponent(cleanKey)}` 
                : `${endpointUrl}?key=${encodeURIComponent(cleanKey)}`;
            attempts.push({ url: urlWithKey, opts: options });
            attempts.push({
                url: endpointUrl,
                opts: {
                    ...options,
                    headers: { ...(options.headers || {}), 'X-Goog-Api-Key': cleanKey }
                }
            });
            attempts.push({
                url: endpointUrl,
                opts: {
                    ...options,
                    headers: { ...(options.headers || {}), 'Authorization': `Bearer ${cleanKey}` }
                }
            });
        }

        let lastRes = null;
        for (const attempt of attempts) {
            try {
                const res = await fetch(attempt.url, attempt.opts);
                if (res.ok) return res;
                lastRes = res;
            } catch (e) {}
        }

        return lastRes;
    }

    let _cachedGeminiModelsList = null;
    let _cachedGeminiKey = null;
    let _cachedGeminiTime = 0;

    async function fetchAvailableGeminiModels(key) {
        const cleanKey = sanitizeGeminiApiKey(key);
        if (!cleanKey) throw new Error("API klíč je prázdný");

        const now = Date.now();
        if (_cachedGeminiModelsList && _cachedGeminiKey === cleanKey && (now - _cachedGeminiTime < 300000)) {
            return _cachedGeminiModelsList;
        }

        const res = await fetchGeminiApi(`https://generativelanguage.googleapis.com/v1beta/models`, cleanKey);
        if (!res.ok) {
            const errJson = await res.json().catch(() => ({}));
            throw new Error(errJson?.error?.message || `HTTP ${res.status}`);
        }
        const data = await res.json();
        const models = (data?.models || [])
            .filter(m => Array.isArray(m.supportedGenerationMethods) && m.supportedGenerationMethods.includes("generateContent"))
            .map(m => m.name.replace(/^models\//, ''));

        if (models.length > 0) {
            _cachedGeminiModelsList = models;
            _cachedGeminiKey = cleanKey;
            _cachedGeminiTime = now;
        }
        return models;
    }

