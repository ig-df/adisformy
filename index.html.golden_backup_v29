    function handleMachineMoldKeydown(e) {
        const suggEl = document.getElementById('machineMoldSuggestions');
        const isSuggVisible = suggEl && suggEl.style.display === 'block';

        if (isSuggVisible && machineMoldCurrentMatches.length > 0) {
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                machineMoldActiveIndex = (machineMoldActiveIndex + 1) % machineMoldCurrentMatches.length;
                highlightMachineMoldActiveSuggestion();
                return;
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                machineMoldActiveIndex = (machineMoldActiveIndex - 1 + machineMoldCurrentMatches.length) % machineMoldCurrentMatches.length;
                highlightMachineMoldActiveSuggestion();
                return;
            } else if (e.key === 'Enter') {
                if (machineMoldActiveIndex >= 0 && machineMoldActiveIndex < machineMoldCurrentMatches.length) {
                    e.preventDefault();
                    selectMachineMoldSuggestion(machineMoldCurrentMatches[machineMoldActiveIndex].num);
                    return;
                }
            } else if (e.key === 'Escape') {
                closeMachineMoldSuggestions();
                return;
            }
        }

        if (e.key === 'Enter') {
            closeMachineMoldSuggestions();
            saveMachineMoldNumber();
        }
    }

    function highlightMachineMoldActiveSuggestion() {
        const suggEl = document.getElementById('machineMoldSuggestions');
        if (!suggEl) return;
        const items = suggEl.querySelectorAll('.mach-mold-dropdown-item');
