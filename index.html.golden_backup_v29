    async function openLogsModal() {
        showModalAnimated('logsModal');
        const clearLogsBtnFooter = document.getElementById('clearLogsBtnFooter');
        if (clearLogsBtnFooter) clearLogsBtnFooter.style.display = isSuperUser ? 'inline-block' : 'none';

        const list = document.getElementById('logsList');
        list.innerHTML = `<div class="no-data">Načítání historie...</div>`;
        try {
            const res = await fetch(`${API_URL}/rest/v1/mold_logs?select=*&order=created_at.desc&limit=250`, { headers: { 'apikey': API_KEY, 'Authorization': `Bearer ${API_KEY}` } });
            let logs = await res.json();

            // Strictly filter: only significant operations, no shift plan clutter, login records only for superuser
            logs = (logs || []).filter(log => isSignificantAuditLog(log, isSuperUser));

            // Silent deduplication of identical consecutive logs for clean presentation
            const cleanLogs = [];
            for (let i = 0; i < logs.length; i++) {
                const cur = logs[i];
                const prev = cleanLogs[cleanLogs.length - 1];
                if (prev &&
                    String(prev.mold_id || '').trim().toUpperCase() === String(cur.mold_id || '').trim().toUpperCase() &&
                    String(prev.old_position || '').trim().toLowerCase() === String(cur.old_position || '').trim().toLowerCase() &&
                    String(prev.new_position || '').trim().toLowerCase() === String(cur.new_position || '').trim().toLowerCase() &&
                    String(prev.user_name || '').trim().toLowerCase() === String(cur.user_name || '').trim().toLowerCase()) {
                    continue;
                }
                cleanLogs.push(cur);
            }

            if (cleanLogs.length === 0) { list.innerHTML = `<div class="no-data">Zatím žádná historie</div>`; return; }
            list.innerHTML = cleanLogs.map(log => {
                const moldIdStr = String(log.mold_id || '').trim();
                const isLogin = moldIdStr.toUpperCase() === 'SYSTEM' || String(log.old_position || '').toLowerCase().includes('autorizace') || String(log.new_position || '').toLowerCase().includes('přihlášen') || String(log.new_position || '').toLowerCase().includes('přihlášení');

                if (isLogin) {
                    return `
                    <div class="log-item">
                        <div><strong>🔑 ${escapeHtml(log.new_position || 'Přihlášení do systému')}</strong></div>
                        <div class="log-meta"><span>${escapeHtml(log.user_name || 'Neznámý')}</span><span>${new Date(log.created_at).toLocaleString('cs-CZ')}</span></div>
                    </div>
                    `;
                }

                const targetObj = formatMoldLogTarget(moldIdStr);
                const labelHtml = targetObj.isMachine
                    ? `<strong>Lis č. ${escapeHtml(targetObj.cleanId)}</strong>`
                    : `Forma <strong>${escapeHtml(targetObj.cleanId)}</strong>`;
                return `
                <div class="log-item">
                    <div>${labelHtml}: <span style="text-decoration: line-through; opacity: 0.6;">${escapeHtml(log.old_position || '—')}</span> &rarr; <strong>${escapeHtml(log.new_position)}</strong></div>
                    <div class="log-meta"><span>${escapeHtml(log.user_name || 'Neznámý')}</span><span>${new Date(log.created_at).toLocaleString('cs-CZ')}</span></div>
                </div>
            `;}).join('');
        } catch (e) { list.innerHTML = `<div class="no-data" style="color:var(--error-text)">Chyba načítání</div>`; }
    }

