    function scannerConfirmBatchAdd() {
        if (scannerSelectedBatchMoldIds.size === 0) return;
        triggerHapticFeedback([25, 45, 25]);

        let addedCount = 0;
        scannerSelectedBatchMoldIds.forEach(mId => {
            const cleanId = String(mId).trim();
            const exists = currentShiftPlan.some(item => String(item.num || item.id).trim() === cleanId);
            if (!exists) {
                const moldData = rawDatabase.find(m => String(m[0]).trim() === cleanId);
                if (moldData) {
                    const batchItem = scannerBatchMolds.find(b => String(b[0]).trim() === cleanId);
                    const machineNum = (batchItem && batchItem._machine) ? String(batchItem._machine) : '';

                    currentShiftPlan.push({
                        num: cleanId,
                        id: cleanId,
                        pos: moldData[1] || 'Mezisklad',
                        customer: moldData[2] || '',
                        product: moldData[5] || '',
                        machine: machineNum,
                        checked: false,
                        addedAt: Date.now()
                    });
                    addedCount++;
                }
            }
        });

        if (addedCount > 0) {
            saveShiftPlan();
            showToast(`Přidáno ${addedCount} forem do plánu směny!`);
            closeNumberScanner();
            // Start flight animation cleanly after the scanner has closed and faded out
            setTimeout(() => {
                animateFlyToShiftPlanButton(addedCount);
            }, 320);
        } else {
            showToast("Všechny vybrané formy již v plánu jsou.");
            closeNumberScanner();
        }
    }

    // Smooth industrial fly-to-cart animation for scanned shift plan items
    function animateFlyToShiftPlanButton(count) {
        try {
            const targetBtn = document.getElementById('shiftPlanCornerBtn');
            if (!targetBtn) return;
            const targetRect = targetBtn.getBoundingClientRect();
            if (targetRect.width === 0 && targetRect.height === 0) return;

            const targetX = targetRect.left + (targetRect.width / 2);
            const targetY = targetRect.top + (targetRect.height / 2);

            // Starting point: clean center-screen position
            const startX = window.innerWidth / 2;
            const startY = Math.max(160, window.innerHeight / 2 - 40);

            const particle = document.createElement('div');
            particle.className = 'scan-fly-particle';
            particle.innerHTML = `
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width: 20px; height: 20px; color: #10b981; flex-shrink: 0;">
                    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                    <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                    <path d="m9 14 2 2 4-4"></path>
                </svg>
                <span>+${count} do plánu</span>
            `;

            particle.style.left = `${startX}px`;
            particle.style.top = `${startY}px`;
            particle.style.transform = 'translate(-50%, -50%) scale(0.6)';
            particle.style.opacity = '0';
            document.body.appendChild(particle);

            // Phase 1: Clear, crisp presentation in center
            requestAnimationFrame(() => {
                particle.style.transition = 'transform 0.35s cubic-bezier(0.18, 0.9, 0.3, 1.25), opacity 0.28s ease';
                particle.style.transform = 'translate(-50%, -50%) scale(1.15)';
                particle.style.opacity = '1';

                // Phase 2: Distinct flight arc into corner list button
                setTimeout(() => {
                    const deltaX = targetX - startX;
                    const deltaY = targetY - startY;
                    particle.style.transition = 'transform 0.95s cubic-bezier(0.22, 0.85, 0.3, 1), opacity 0.95s cubic-bezier(0.4, 0, 0.85, 1)';
                    particle.style.transform = `translate(calc(-50% + ${deltaX}px), calc(-50% + ${deltaY}px)) scale(0.4)`;
                    particle.style.opacity = '0.45';

                    // Phase 3: Landing into basket button with spring bounce
                    setTimeout(() => {
                        if (particle.parentNode) {
                            particle.parentNode.removeChild(particle);
                        }
                        targetBtn.classList.remove('pulse-receive');
                        void targetBtn.offsetWidth; // trigger reflow
                        targetBtn.classList.add('pulse-receive');
                        triggerHapticFeedback([30, 45]);
                        updateShiftPlanBadge();
                    }, 930);
                }, 420);
            });
        } catch (e) {
            console.warn('Fly animation error:', e);
        }
    }

