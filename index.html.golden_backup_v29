    function applyFactoryMachinesData(newMachinesArray) {
        if (!Array.isArray(newMachinesArray) || newMachinesArray.length === 0) return;
        const incomingMap = {};
        newMachinesArray.forEach(item => {
            if (item && item.id) {
                incomingMap[item.id] = item;
            }
        });

        factoryMachinesData = FACTORY_MACHINE_NUMBERS.map(num => {
            const existing = incomingMap[num];
            return {
                id: num,
                number: String(num),
                status: existing?.status || 'ok',
                currentMold: existing?.currentMold || '',
                issues: Array.isArray(existing?.issues) ? existing.issues : []
            };
        });

        try {
            localStorage.setItem(FACTORY_MACHINES_STORAGE_KEY, JSON.stringify(factoryMachinesData));
        } catch (e) {}

        const mapPage = document.getElementById('factoryMapPage');
        if (mapPage && mapPage.classList.contains('active')) {
            renderGraphicFactoryMap();
            if (currentActiveMachineId) {
                const activeMach = factoryMachinesData.find(m => m.id === currentActiveMachineId);
                if (activeMach) {
                    renderMachineProblemStatusBanner(activeMach);
                    updateMachineStatusButtonsUI(activeMach.status);
                    renderMachineIssuesList(activeMach);
                    const moldInput = document.getElementById('machineMoldInput');
                    if (moldInput && document.activeElement !== moldInput) {
                        moldInput.value = activeMach.currentMold || '';
                        const clearMoldBtn = document.getElementById('btnClearMachineMold');
                        const goToMoldBtn = document.getElementById('btnGoToMachineMold');
                        const hasMold = !!(activeMach.currentMold && activeMach.currentMold.trim());
                        if (clearMoldBtn) clearMoldBtn.style.display = hasMold ? 'inline-flex' : 'none';
                        if (goToMoldBtn) goToMoldBtn.style.display = hasMold ? 'inline-flex' : 'none';
                        updateMachineMoldProductPreview(activeMach.currentMold || '');
                    }
                }
            }
        }
    }

    async function syncFactoryMachinesFromDb() {
        if (!supabaseClient || isSyncingFactoryMachines) return;
        try {
            const { data, error } = await supabaseClient
                .from('app_settings')
                .select('value')
                .eq('key', 'adis_factory_machines_state_v1')
                .maybeSingle();

            if (!error && data && data.value) {
                let parsed = null;
                try {
                    parsed = typeof data.value === 'string' ? JSON.parse(data.value) : data.value;
                } catch (pe) {
                    parsed = null;
                }
                if (Array.isArray(parsed) && parsed.length > 0) {
                    applyFactoryMachinesData(parsed);
                }
            }
        } catch (e) {
            console.warn('Chyba synchronizace dat lisů ze Supabase:', e);
        }
    }

    async function syncFactoryMachinesToDb() {
        if (!supabaseClient || isSubmittingAction) return;
        try {
            isSyncingFactoryMachines = true;
            await supabaseClient
                .from('app_settings')
                .upsert([
                    {
                        key: 'adis_factory_machines_state_v1',
                        value: JSON.stringify(factoryMachinesData)
                    }
                ], { onConflict: 'key' });
        } catch (err) {
            console.error('Chyba při ukládání stavu lisů do Supabase:', err);
        } finally {
            setTimeout(() => {
                isSyncingFactoryMachines = false;
            }, 300);
        }
    }

    function initFactoryMachinesData() {
        let existingMap = {};
        try {
            const stored = localStorage.getItem(FACTORY_MACHINES_STORAGE_KEY);
            if (stored) {
                const parsed = JSON.parse(stored);
                if (Array.isArray(parsed)) {
                    parsed.forEach(item => {
                        if (item && item.id) {
                            existingMap[item.id] = item;
                        }
                    });
                }
            }
        } catch (e) {
            console.error('Chyba načítání dat strojů:', e);
        }

        // Přesně 29 strojů podle dílenského nákresu
        factoryMachinesData = FACTORY_MACHINE_NUMBERS.map(num => {
            const existing = existingMap[num];
            return {
                id: num,
                number: String(num),
                status: existing?.status || 'ok',
                currentMold: existing?.currentMold || '',
                issues: Array.isArray(existing?.issues) ? existing.issues : []
            };
        });

        saveFactoryMachinesState(false);
        syncFactoryMachinesFromDb();
    }

    function saveFactoryMachinesState(shouldSyncToDb = true) {
        try {
            localStorage.setItem(FACTORY_MACHINES_STORAGE_KEY, JSON.stringify(factoryMachinesData));
        } catch (e) {
            console.error('Chyba ukládání dat strojů:', e);
        }

        if (shouldSyncToDb) {
