        /* Průmyslový technický výkres lisovny - rozšířený formát s trasy a šipkami */
        .factory-monochrome-canvas {
            background: #f8fafc;
            background-image: radial-gradient(#cbd5e1 0.75px, transparent 0.75px);
            background-size: 16px 16px;
            width: 100%;
            max-width: 820px;
            min-width: 630px;
            border: 2px solid #0f172a;
            border-radius: 10px;
            box-shadow: 0 4px 20px rgba(15, 23, 42, 0.08);
            position: relative;
            padding: 0.85rem 1rem;
            margin-bottom: 1.5rem;
            box-sizing: border-box;
        }

        /* Horní a spodní spojovací dopravní trasa se šipkami a šтрихпунктиром */
        .factory-cross-way {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 0.35rem 0.5rem;
            margin-bottom: 0.65rem;
            user-select: none;
