        const othersObj = customersList.find(c => c.name.toLowerCase() === 'others') || { name: "Others", bg: "#fdfbf7" };
        const sortedCustomers = [...listWithoutOthers, othersObj];

        sortedCustomers.forEach((c) => {
            const isActive = currentCustomerFilter === c.name ? 'active' : '';
            let chipStyle = `background-color: ${c.bg}; color: #000000; border-color: #cbd5e1;`;

