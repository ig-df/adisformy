    async function renderPdfPage(pageNum) {
        if (!currentPdfDoc) return;
        isRenderingPdfPage = true;

        try {
            const page = await currentPdfDoc.getPage(pageNum);
            const canvas = document.getElementById('pdfCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');

            const viewport = page.getViewport({ scale: pdfZoomScale, rotation: pdfRotationAngle });
            const pixelRatio = window.devicePixelRatio || 1;

            canvas.width = Math.floor(viewport.width * pixelRatio);
            canvas.height = Math.floor(viewport.height * pixelRatio);
            canvas.style.width = Math.floor(viewport.width) + 'px';
            canvas.style.height = Math.floor(viewport.height) + 'px';

            ctx.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);

            const renderContext = {
                canvasContext: ctx,
                viewport: viewport
            };

            await page.render(renderContext).promise;
            isRenderingPdfPage = false;

            if (pendingPdfPageNum !== null) {
                const nextNum = pendingPdfPageNum;
                pendingPdfPageNum = null;
                renderPdfPage(nextNum);
            }

            const curEl = document.getElementById('pdfCurrentPage');
            if (curEl) curEl.textContent = pageNum;

            const prevBtn = document.getElementById('pdfPrevBtn');
            const nextBtn = document.getElementById('pdfNextBtn');
            if (prevBtn) prevBtn.disabled = (pageNum <= 1);
            if (nextBtn) nextBtn.disabled = (pageNum >= totalPdfPages);

            const zoomDisplay = document.getElementById('pdfZoomDisplay');
            if (zoomDisplay) zoomDisplay.textContent = `${Math.round(pdfZoomScale * 100)}%`;
        } catch (e) {
            isRenderingPdfPage = false;
            console.error("Chyba renderování strany PDF:", e);
        }
    }

    function queueRenderPdfPage(pageNum) {
        if (isRenderingPdfPage) {
            pendingPdfPageNum = pageNum;
        } else {
            renderPdfPage(pageNum);
        }
    }

    function changePdfPage(delta) {
        if (!currentPdfDoc) return;
        const newPage = currentPdfPage + delta;
        if (newPage >= 1 && newPage <= totalPdfPages) {
            triggerHapticFeedback([10]);
            currentPdfPage = newPage;
