    function handleSearch() {
        const searchInputEl = document.getElementById('searchInput');
        const rawQuery = searchInputEl ? searchInputEl.value : '';
        const query = rawQuery.trim().toLowerCase();
        const tbody = document.getElementById('searchResults');
        const stats = document.getElementById('searchStats');
        const clearBtn = document.getElementById('btnClearSearch');

        if (clearBtn) {
            clearBtn.style.display = query.length > 0 ? 'inline-flex' : 'none';
        }

        if (!tbody) return;

        if (!query) {
            if (stats) stats.textContent = '';
            tbody.innerHTML = `<tr><td colspan="3" class="no-data-centered" style="text-align: center !important; color: var(--text-muted); font-size: 0.85rem; padding: 2rem 1rem !important;">Začněte psát do pole výše</td></tr>`;
            return;
        }

        if (query.length >= 2) {
            clearTimeout(searchLogDebounceTimer);
            searchLogDebounceTimer = setTimeout(() => {
                logUserAction('HLEDÁNÍ', 'Vyhledávání', `Hledal: "${rawQuery.trim()}"`);
            }, 1200);
        }

        // Leading zeros normalization for mold numbers (e.g. "000584", "00584", "0584" -> "584")
        const strippedZerosQuery = /^\d+$/.test(query) ? query.replace(/^0+/, '') || '0' : null;

        const activeMolds = rawDatabase.filter(item => !item[4]);
        const scoredMatches = [];
        for (const item of activeMolds) {
            const [num, pos, cust, status, isDel, productName] = item;
            const strNum = String(num).toLowerCase();
            const strippedMoldNum = /^\d+$/.test(strNum) ? strNum.replace(/^0+/, '') || '0' : null;
            const strPos = String(pos).toLowerCase();
            const strCust = String(cust).toLowerCase();
            const strProd = String(productName || '').toLowerCase();
            const strStatus = String(status || '').toLowerCase();

            let score = 0;

            // 1. Exact ID match (highest priority), including leading zero normalization
            if (strNum === query) {
                score += 1000;
            } else if (strippedZerosQuery && strippedMoldNum && strippedMoldNum === strippedZerosQuery) {
                score += 990;
            } else if (strNum.startsWith(query)) {
                score += 500;
            } else if (strippedZerosQuery && strippedMoldNum && strippedMoldNum.startsWith(strippedZerosQuery)) {
                score += 480;
            } else if (strNum.includes(query)) {
                score += 200;
            }

            // 2. Product Name match: prioritize exact, compact compound, and whole-word matches over arbitrary substrings
            if (strProd) {
                const compactProd = toCompactMatchStr(strProd);
                const compactQuery = toCompactMatchStr(query);
                if (compactProd && compactQuery && compactProd === compactQuery) {
                    score += 950;
                } else if (strProd === query) {
                    score += 800;
                } else if (isWholeWordOrPhraseMatch(strProd, query)) {
                    score += 600;
                } else if (strProd.startsWith(query)) {
                    score += 300;
                } else if (strProd.includes(query) && !/^\d+$/.test(query)) {
                    score += 100;
                }
            }

            // 3. Customer match
            if (strCust === query) {
                score += 400;
            } else if (isWholeWordOrPhraseMatch(strCust, query)) {
                score += 300;
            } else if (strCust.includes(query)) {
                score += 150;
            }

            // 4. Position & Status match
            if (strPos === query || strPos.startsWith(query)) {
                score += 250;
            } else if (strPos.includes(query)) {
                score += 120;
            }
            if (strStatus.includes(query)) {
                score += 80;
            }

            if (score > 0) {
                scoredMatches.push({ item, score });
            }
        }

        // Sort by relevance score descending so exact & whole-word matches appear first
        scoredMatches.sort((a, b) => b.score - a.score);
        const matched = scoredMatches.map(m => m.item);

        stats.textContent = `Nalezeno výsledků: ${matched.length}`;

        if (matched.length === 0) {
            const cleanQuery = escapeHtml(document.getElementById('searchInput').value.trim());
            tbody.innerHTML = `
                <tr>
                    <td colspan="3" style="padding: 0 !important; background: transparent; border: none;">
                        <div class="empty-state-card">
                            <div class="empty-state-icon-box">
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="11" cy="11" r="8"></circle>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                </svg>
                            </div>
                            <div class="empty-state-title">Forma <span class="highlight-mold">#${cleanQuery}</span> nebyla nalezena</div>
                            <div class="empty-state-desc">V evidenci zatím neexistuje záznam odpovídající tomuto číslu nebo výrazu.</div>
                            <button type="button" class="empty-state-btn" onclick="openAddModal(document.getElementById('searchInput') ? document.getElementById('searchInput').value.trim() : '')">
