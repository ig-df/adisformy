    const MAX_RECENT_LOGS_BUFFER = 25;
    const LOG_DUPLICATE_TIME_WINDOW_MS = 20000; // 20s deduplication window

    async function logUserAction(moldId, oldPos, newPos) {
        if (!currentUser) return;
        const cleanMoldId = String(moldId || 'SYSTEM').trim();
        const cleanOldPos = String(oldPos || 'Akce').trim();
        const cleanNewPos = String(newPos || '').trim();
        const cleanUser = String(currentUser).trim();
        const now = Date.now();

        // Silent deduplication filter: prevent duplicate spam across all actions, searches, and tasks
        const logSignature = `${cleanUser}___${cleanMoldId}___${cleanOldPos}___${cleanNewPos}`.toLowerCase();

        // Prune expired entries from buffer
        while (recentLogsRingBuffer.length > 0 && (now - recentLogsRingBuffer[0].time) > LOG_DUPLICATE_TIME_WINDOW_MS) {
            recentLogsRingBuffer.shift();
        }

        // Check if identical action was logged recently
        const isDuplicate = recentLogsRingBuffer.some(entry => entry.signature === logSignature && (now - entry.time) < LOG_DUPLICATE_TIME_WINDOW_MS);
        if (isDuplicate) {
            return;
        }

        // Record entry in buffer
        recentLogsRingBuffer.push({
            signature: logSignature,
            time: now
        });
        if (recentLogsRingBuffer.length > MAX_RECENT_LOGS_BUFFER) {
            recentLogsRingBuffer.shift();
        }

        try {
            await fetch(`${API_URL}/rest/v1/mold_logs`, {
                method: 'POST',
                headers: { 
                    'apikey': API_KEY, 
                    'Authorization': `Bearer ${API_KEY}`, 
                    'Content-Type': 'application/json' 
                },
                body: JSON.stringify({
                    mold_id: cleanMoldId,
                    old_position: cleanOldPos,
                    new_position: cleanNewPos,
                    user_name: cleanUser
                })
            });
        } catch(e) {
            console.warn("Log user action failed:", e);
        }
    }

    function isUserActivityInspectorLog(log) {
        if (!log || !log.created_at) return false;
        return true;
    }

    async function openUserActivityModal(userName, deviceType = '', lastSeenIso = '') {
        triggerHapticFeedback([12]);
        closeOnlineUsersPopover();

        currentUserActivityTarget = userName;
        currentUserActivityFilter = 'ALL';

        // Load logs in real-time first so there is zero flickering or counter resetting
        let logs = [];
        try {
            const { data: logsExact, error: errExact } = await supabaseClient
                .from('mold_logs')
                .select('*')
                .eq('user_name', userName)
                .order('created_at', { ascending: false })
                .limit(350);

            if (!errExact && logsExact) {
                logs = logsExact;
            }

            if (logs.length === 0) {
                const { data: logsIlike } = await supabaseClient
                    .from('mold_logs')
                    .select('*')
                    .ilike('user_name', `%${userName}%`)
                    .order('created_at', { ascending: false })
                    .limit(350);
                if (logsIlike && logsIlike.length > 0) {
                    logs = logsIlike;
                }
            }
        } catch(err) {
            console.error("Chyba při načítání aktivity uživatele:", err);
        }

        // Filter and deduplicate consecutive identical actions
        const rawLogs = (logs || []).filter(isUserActivityInspectorLog);
        const deduplicatedLogs = [];
        for (let i = 0; i < rawLogs.length; i++) {
            const cur = rawLogs[i];
            const prev = deduplicatedLogs[deduplicatedLogs.length - 1];
            if (prev &&
                String(prev.mold_id || '').trim().toUpperCase() === String(cur.mold_id || '').trim().toUpperCase() &&
                String(prev.old_position || '').trim().toLowerCase() === String(cur.old_position || '').trim().toLowerCase() &&
                String(prev.new_position || '').trim().toLowerCase() === String(cur.new_position || '').trim().toLowerCase()) {
                continue;
            }
            deduplicatedLogs.push(cur);
        }

        currentUserActivityData = deduplicatedLogs;

        // Compute metrics directly with real data
        let totalCount = currentUserActivityData.length;
        let moveCount = 0;
        let planCount = 0;
        let exploreCount = 0;

        currentUserActivityData.forEach(item => {
            const moldIdStr = String(item.mold_id || '').toUpperCase();
            const oldPosStr = String(item.old_position || '').toLowerCase();
            const newPosStr = String(item.new_position || '').toLowerCase();
            const combined = (oldPosStr + ' ' + newPosStr).toLowerCase();

            if (oldPosStr === 'plán na směnu' || combined.includes('odebráno') || combined.includes('splněn úkol') || combined.includes('v plánu') || combined.includes('do plánu')) {
                planCount++;
            } else if (combined.includes('pozic') || combined.includes('stav') || oldPosStr === 'položka vytvořena' || oldPosStr === 'nová forma' || oldPosStr === 'koš' || newPosStr === 'obnovena' || combined.includes('mezisklad') || combined.includes('koment') || combined.includes('poznámk') || (combined.includes('foto') && !combined.includes('zobrazena')) || (combined.includes('návodk') && !combined.includes('zobrazena'))) {
                moveCount++;
            } else {
                exploreCount++;
            }
        });

        // Set all modal header and metric DOM values synchronously to final values
        const titleEl = document.getElementById('userActivityTitle');
        const subtitleEl = document.getElementById('userActivitySubtitle');
        if (titleEl) titleEl.textContent = `Aktivita: ${userName}`;
        
        let subText = '';
        if (deviceType) subText += getDeviceBadgeHtml(deviceType);
        if (lastSeenIso) {
            const dateStr = new Date(lastSeenIso).toLocaleString('cs-CZ');
            if (subText) subText += `<span style="margin: 0 4px; opacity: 0.4;">•</span>`;
            subText += `<span>Poslední spojení: ${escapeHtml(dateStr)}</span>`;
        }
        if (subtitleEl) subtitleEl.innerHTML = subText;

        const uTotal = document.getElementById('uactTotal');
        const uMoves = document.getElementById('uactMoves');
        const uSearches = document.getElementById('uactSearches');
        const uNotes = document.getElementById('uactNotes');
        if (uTotal) uTotal.textContent = totalCount;
        if (uMoves) uMoves.textContent = moveCount;
        if (uSearches) uSearches.textContent = planCount;
        if (uNotes) uNotes.textContent = exploreCount;

        const listEl = document.getElementById('userActivityList');
        if (listEl) {
            listEl.style.opacity = '1';
        }

        renderUserActivityList();

        // Show modal once content and metrics are 100% prepared
        showModalAnimated('userActivityModal');
    }

