    function isSignificantAuditLog(log, isSuper = false) {
        if (!log) return false;
        const moldId = String(log.mold_id || '').trim().toUpperCase();
        const oldPos = String(log.old_position || '').trim();
        const newPos = String(log.new_position || '').trim();
        const combined = (oldPos + ' ' + newPos).toLowerCase();

        // 1. Shift plan ("Seznam forem na směnu") & batch scans: strictly excluded from history
        if (moldId.startsWith('LIS_') || moldId === 'PLÁN' || moldId === 'SKENER' || moldId === 'HLEDÁNÍ') return false;
        if (oldPos === 'Plán na směnu' || oldPos === 'Dávkový sken' || oldPos === 'Vyhledávání' || oldPos === 'Skenování') return false;
        if (combined.includes('plán na směnu') || combined.includes('do plánu') || combined.includes('v plánu') || combined.includes('dávkový sken')) return false;

        // 2. Telemetry and inspection events (opening detail, opening PDF viewer, photo view, searches, scanner matches, tab navigation, filters, exports)
        if (oldPos === 'Detail formy' || newPos === 'Otevřen detail formy' || combined.includes('otevřen detail')) return false;
        if (oldPos === 'Návodka' && newPos.includes('Zobrazena návodka')) return false;
        if (oldPos === 'Fotografie' && newPos.includes('Zobrazena fot')) return false;
        if (oldPos === 'Navigace' || combined.includes('přepnutí na záložku')) return false;
        if (oldPos === 'Filtr' || combined.includes('filtr zákazníka') || combined.includes('filtr stavu')) return false;
        if (oldPos === 'Export' || combined.includes('export dat')) return false;
        if (combined.includes('hledal:') || combined.includes('forma rozpoznána') || combined.includes('rozpoznána forma') || combined.includes('naskenován')) return false;

        // 3. User login / authorization events: visible ONLY for superuser
        const isLogin = moldId === 'SYSTEM' || combined.includes('autorizace') || combined.includes('přihlášen') || combined.includes('přihlášení');
        if (isLogin) {
            return Boolean(isSuper);
        }

        // 4. Main core functions:
        // - Adding a new mold
        if (oldPos === 'Nová forma' || combined.includes('vytvořena')) return true;
        // - Moving mold / position changes (including trash and restore)
        if (oldPos.includes('Pozice:') || newPos.includes('Pozice:') || (oldPos === 'Aktivní' && newPos === 'Koš') || oldPos === 'Koš' || newPos === 'Obnovena' || combined.includes('mezisklad') || combined.includes('přesun')) return true;
        // - Status / customer changes
        if (oldPos.includes('Stav:') || newPos.includes('Stav:') || combined.includes('zákazník:')) return true;
        // - Photos: upload, update, delete (not passive viewing)
        if ((combined.includes('foto') || combined.includes('fotograf')) && !combined.includes('zobrazena')) return true;
        // - Navodka: add, update, delete (not passive viewing)
        if (combined.includes('návodk') && !combined.includes('zobrazena')) return true;
        // - Comments / notes
        if (combined.includes('poznámk')) return true;

        return false;
    }

    function formatMoldLogTarget(rawId) {
        const str = String(rawId || '').trim();
        const lisMatch = str.match(/^#?LIS[-_ ]*(\d+)$/i);
        if (lisMatch) {
            return {
                isMachine: true,
                cleanId: lisMatch[1],
                label: `Lis č. ${lisMatch[1]}`,
                header: `Lis č. ${lisMatch[1]}`
            };
        }
        const cleanNum = str.replace(/^#+/, '');
        return {
            isMachine: false,
            cleanId: cleanNum,
            label: `Forma #${cleanNum}`,
            header: `Forma: ${cleanNum}`
        };
    }

