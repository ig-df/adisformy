    function getPositionBadgeClass(pos) {
        const p = String(pos || "").trim().toLowerCase();
        if (p.includes("externí") || p.includes("externi")) return 'badge-position pos-externi';
        if (p.includes("mezisklad")) return 'badge-position pos-mezisklad';
        if (p.includes(' z')) return 'badge-position pos-z';
        if (p.includes(' c') || p.includes(' č')) return 'badge-position pos-c';
        if (p.includes(' m')) return 'badge-position pos-m';
        if (p.includes(' b')) return 'badge-position pos-b';
        if (p.includes(' h')) return 'badge-position pos-h';
        const lastChar = p.replace('.', '').slice(-1);
        if (['z', 'c', 'č', 'm', 'b', 'h'].includes(lastChar)) {
            if (lastChar === 'č') return 'badge-position pos-c';
            return `badge-position pos-${lastChar}`;
        }
        return 'badge-position pos-mezisklad';
    }

