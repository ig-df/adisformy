    let isRowSwipeInProgress = false;

    function initSwipeNavigation() {
        const swipeArea = document.getElementById('swipeContentArea');
        if (!swipeArea) return;

        let startX = 0;
        let startY = 0;
        let isMouseDown = false;
        let mouseStartX = 0;
        let mouseStartY = 0;
        let wheelTabLock = false;
        const tabsOrder = ['search', 'database', 'dashboard'];

        const performTabSwitch = (diffX) => {
            const currentActive = tabsOrder.find(t => document.getElementById(`tab-${t}`)?.classList.contains('active'));
            const currentIndex = tabsOrder.indexOf(currentActive);

            if (diffX < 0) {
                if (currentIndex < tabsOrder.length - 1) {
                    triggerHapticFeedback([12]);
                    switchTab(tabsOrder[currentIndex + 1]);
                }
            } else {
                if (currentIndex > 0) {
                    triggerHapticFeedback([12]);
                    switchTab(tabsOrder[currentIndex - 1]);
                }
            }
        };

        // Touch events (Mobile & Touchscreens)
        swipeArea.addEventListener('touchstart', (e) => {
            if (isRowSwipeInProgress) return;
            if (e.target.closest('input, textarea, select, .customer-filters, .position-filters-scroll, .modal-card, .accordion-floating-layer, .pdf-scroll-area, .scanner-viewport-wrapper')) return;
            startX = e.touches[0].clientX;
            startY = e.touches[0].clientY;
        }, { passive: true });

        swipeArea.addEventListener('touchend', (e) => {
            if (!startX || isRowSwipeInProgress) return;
            const endX = e.changedTouches[0].clientX;
            const endY = e.changedTouches[0].clientY;

            const diffX = endX - startX;
            const diffY = endY - startY;

            if (Math.abs(diffX) > 55 && Math.abs(diffX) > Math.abs(diffY) * 1.3) {
                performTabSwitch(diffX);
            }

            startX = 0;
            startY = 0;
        }, { passive: true });

        // Mouse Drag events (PC Desktop)
        swipeArea.addEventListener('mousedown', (e) => {
            if (e.button !== 0 || isRowSwipeInProgress) return;
            if (e.target.closest('input, textarea, select, .customer-filters, .position-filters-scroll, .modal-card, .accordion-floating-layer, .pdf-scroll-area, .scanner-viewport-wrapper, button, a')) return;
            isMouseDown = true;
            mouseStartX = e.clientX;
            mouseStartY = e.clientY;
        });

        window.addEventListener('mouseup', (e) => {
            if (!isMouseDown) return;
            isMouseDown = false;
            if (isRowSwipeInProgress) return;

            const diffX = e.clientX - mouseStartX;
            const diffY = e.clientY - mouseStartY;

            if (Math.abs(diffX) > 60 && Math.abs(diffX) > Math.abs(diffY) * 1.3) {
                performTabSwitch(diffX);
            }
        });

        // Trackpad / Wheel Horizontal Swipe (PC Laptop / Desktop Trackpads)
        swipeArea.addEventListener('wheel', (e) => {
            if (wheelTabLock || isRowSwipeInProgress) return;
            if (e.target.closest('.position-filters-scroll, .customer-filters, .modal-body, .table-container, input, textarea, select')) return;

            if (Math.abs(e.deltaX) > 35 && Math.abs(e.deltaX) > Math.abs(e.deltaY) * 1.8) {
                wheelTabLock = true;
                performTabSwitch(-e.deltaX);
                setTimeout(() => { wheelTabLock = false; }, 450);
            }
        }, { passive: true });
    }

    function initTableRowsSwipeGestures() {
        let startX = 0;
        let startY = 0;
        let currentDiffX = 0;
        let swipingTr = null;
        let candidateTr = null;
        let isHoldArmed = false;
        let holdTimer = null;
        let lastSwipeTimestamp = 0;
        let currentArmedZone = 0; // 0: none, 1: comment, 2: delete, -1: edit

        const backdrop = document.getElementById('gmailSwipeBackdrop');
        const actionLeft = document.getElementById('swipeActionLeft');
        const actionRight = document.getElementById('swipeActionRight');
        const pillComment = document.getElementById('swipePillComment');
        const pillDelete = document.getElementById('swipePillDelete');
        const pillEdit = document.getElementById('swipePillEdit');

        const SWIPE_ACTION_THRESHOLD = 70;
        const SWIPE_DELETE_THRESHOLD = 210; /* Significant deliberate travel distance to prevent accidental triggers */

        const isInteractiveTarget = (target) => {
            return Boolean(target.closest('button, .toggle-accordion-btn, .tag-customer, .badge-position, .comment-btn, .edit-btn, .photo-upload-card, .accordion-thumb, .navodka-badge-item, .modal-card, input, select, textarea, a'));
        };

        const handlePressStart = (clientX, clientY, target, isMouse = false) => {
            if (!isMouse) lastTouchInteractionTime = Date.now();
            if (isInteractiveTarget(target)) return;
            const tr = target.closest('tr[id^="accordion-trigger-"]');
            if (!tr) return;

            if (tr.classList.contains('cascade-item')) {
                tr.classList.remove('cascade-item');
                tr.style.animation = '';
                tr.style.animationDelay = '';
            }

            startX = clientX;
            startY = clientY;
            currentDiffX = 0;
            candidateTr = tr;
            isHoldArmed = false;
            currentArmedZone = 0;

            if (holdTimer) clearTimeout(holdTimer);
            holdTimer = setTimeout(() => {
                if (candidateTr) {
                    isHoldArmed = true;
                    swipingTr = candidateTr;
                    swipingTr.classList.add('swipe-armed');
                    haptic.impact();
                }
            }, isMouse ? 140 : 180);
        };

        const handlePressMove = (clientX, clientY, e) => {
            if (!startX && !startY) return;
            if (!candidateTr && !swipingTr) return;

            const diffX = clientX - startX;
            const diffY = clientY - startY;

            if (!isHoldArmed && candidateTr) {
                // If finger moves before hold delay completes (~180ms), cancel tile hold timer
                // so the gesture flows into tab swipe or vertical page scroll
                if (Math.hypot(diffX, diffY) > 8) {
                    if (holdTimer) {
                        clearTimeout(holdTimer);
                        holdTimer = null;
                    }
                    candidateTr = null;
                    return;
                }
            }

            if (isHoldArmed && swipingTr) {
                if (e && e.cancelable) e.preventDefault();
                currentDiffX = diffX;

                if (Math.abs(diffX) > 4) {
                    isRowSwipeInProgress = true;
                    swipingTr.classList.add('swipe-dragging');
                    
                    // Kinematic resistance: smooth initially, dampening as user drags deeper
                    let clampedX = 0;
                    if (diffX < 0) {
                        const abs = Math.abs(diffX);
                        if (abs <= SWIPE_ACTION_THRESHOLD) {
                            clampedX = diffX * 0.85;
                        } else if (abs <= SWIPE_DELETE_THRESHOLD) {
                            const excess = abs - SWIPE_ACTION_THRESHOLD;
                            clampedX = -(SWIPE_ACTION_THRESHOLD * 0.85 + excess * 0.76);
                        } else {
                            const deepExcess = abs - SWIPE_DELETE_THRESHOLD;
                            clampedX = -(SWIPE_ACTION_THRESHOLD * 0.85 + (SWIPE_DELETE_THRESHOLD - SWIPE_ACTION_THRESHOLD) * 0.76 + deepExcess * 0.42);
                            clampedX = Math.max(-265, clampedX);
                        }
                    } else {
                        clampedX = Math.min(130, diffX * 0.82);
                    }
                    
                    // Slide the tile's cells horizontally over the under-layer track
                    const tds = swipingTr.querySelectorAll('td');
                    tds.forEach(td => {
                        td.style.transform = `translateX(${clampedX}px)`;
                        td.style.transition = 'none';
                    });

                    if (backdrop) {
                        const container = swipingTr.closest('.table-container');
                        if (container && backdrop.parentElement !== container) {
                            container.appendChild(backdrop);
                        }
                        backdrop.style.top = `${swipingTr.offsetTop}px`;
                        backdrop.style.left = `0px`;
                        backdrop.style.width = `100%`;
                        backdrop.style.height = `${swipingTr.offsetHeight}px`;
                        backdrop.style.display = 'block';

                        let newZone = 0;
                        const absDiff = Math.abs(diffX);
                        if (diffX < 0) {
                            if (absDiff >= SWIPE_DELETE_THRESHOLD) {
                                newZone = -2; // Deep swipe left: Delete (Requires deliberate 210px drag)
                            } else if (absDiff >= SWIPE_ACTION_THRESHOLD) {
                                newZone = -1; // Medium swipe left: Edit
                            }
                        } else if (diffX >= SWIPE_ACTION_THRESHOLD) {
                            newZone = 1; // Swipe right: Comment
                        }

                        if (newZone !== currentArmedZone) {
                            if (newZone === -2) triggerHapticFeedback([40]);
                            else if (newZone === -1 && currentArmedZone < -1) triggerHapticFeedback([16]);
                            else if (newZone === -1 && currentArmedZone === 0) haptic.threshold();
                            else if (newZone === 1) haptic.threshold();
                            currentArmedZone = newZone;
                        }

                        if (diffX < 0) {
                            // Swipe Left -> reveals Upravit / Gear and deep Smazat / Delete
                            if (actionRight) {
                                actionRight.style.display = 'flex';
                                const progress = Math.min(1, Math.max(0, absDiff / SWIPE_ACTION_THRESHOLD));
                                actionRight.style.opacity = (0.4 + progress * 0.6).toString();
                                
                                if (pillEdit) {
                                    pillEdit.classList.toggle('armed-trigger', newZone === -1);
                                }
                                if (pillDelete) {
                                    // Delete pill only becomes visible when user pulls intentionally past 130px towards the deep zone
                                    pillDelete.classList.toggle('visible-pill', absDiff >= 130);
                                    pillDelete.classList.toggle('armed-trigger-danger', newZone === -2);
                                }
                            }
                            if (actionLeft) {
                                actionLeft.style.opacity = '0';
                                actionLeft.style.display = 'none';
                            }
                        } else {
                            // Swipe Right -> The sliding tile uncovers Poznámka / Comment on the left floor
                            if (actionLeft) {
                                actionLeft.style.display = 'flex';
                                const progress = Math.min(1, Math.max(0, diffX / SWIPE_ACTION_THRESHOLD));
                                actionLeft.style.opacity = (0.4 + progress * 0.6).toString();
                                if (pillComment) pillComment.classList.toggle('armed-trigger', newZone === 1);
                            }
                            if (actionRight) {
                                actionRight.style.opacity = '0';
                                actionRight.style.display = 'none';
                            }
                        }
                    }
                }
            }
        };

        const handlePressEnd = () => {
            if (holdTimer) {
                clearTimeout(holdTimer);
                holdTimer = null;
            }

            if (swipingTr) {
                const targetTr = swipingTr;
                const tds = targetTr.querySelectorAll('td');
                tds.forEach(td => {
                    td.style.transition = 'transform 0.24s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.24s ease';
                    td.style.transform = 'translateX(0px)';
                });

                const triggeredDiffX = currentDiffX;
                const wasSwipingLeftDelete = isRowSwipeInProgress && triggeredDiffX <= -SWIPE_DELETE_THRESHOLD;
                const wasSwipingLeftEdit = isRowSwipeInProgress && triggeredDiffX <= -SWIPE_ACTION_THRESHOLD && triggeredDiffX > -SWIPE_DELETE_THRESHOLD;
                const wasSwipingRightComment = isRowSwipeInProgress && triggeredDiffX >= SWIPE_ACTION_THRESHOLD;

                setTimeout(() => {
                    tds.forEach(td => {
                        td.style.transform = '';
                        td.style.transition = '';
                    });
                    targetTr.classList.remove('swipe-armed', 'swipe-dragging');
                    if (backdrop) {
                        backdrop.style.display = 'none';
                    }
                    if (actionLeft) {
                        actionLeft.style.opacity = '0';
                        actionLeft.style.display = 'none';
                        actionLeft.style.transform = 'translateY(-50%)';
                        if (pillComment) pillComment.classList.remove('armed-trigger');
                    }
                    if (actionRight) {
                        actionRight.style.opacity = '0';
                        actionRight.style.display = 'none';
                        actionRight.style.transform = 'translateY(-50%)';
                        if (pillEdit) pillEdit.classList.remove('armed-trigger');
                        if (pillDelete) pillDelete.classList.remove('visible-pill', 'armed-trigger-danger');
                    }
                }, 240);

                if (wasSwipingLeftDelete || wasSwipingLeftEdit || wasSwipingRightComment) {
                    lastSwipeTimestamp = Date.now();
                    const moldId = targetTr.getAttribute('data-mold-id');
                    if (moldId) {
                        const item = rawDatabase.find(i => String(i[0]) === String(moldId));
                        if (wasSwipingLeftDelete) {
                            // Deep Swipe Left -> Přesunout do koše (Delete)
                            haptic.impact();
                            deleteMoldSoftDirect(moldId);
                        } else if (wasSwipingLeftEdit) {
                            // Medium Swipe Left -> Upravit / Gear / Full edit
                            haptic.success();
                            if (item) {
                                openFullEdit(item[0], item[1], item[3] || '', item[5] || '');
                            } else {
                                openFullEdit(moldId, '', '', '');
                            }
                        } else if (wasSwipingRightComment) {
                            // Swipe Right -> Poznámka / Comment
                            haptic.success();
                            openCommentModal(moldId);
                        }
                    }
                }
            }

            startX = 0;
            startY = 0;
            currentDiffX = 0;
            currentArmedZone = 0;
            swipingTr = null;
            candidateTr = null;
            isHoldArmed = false;
            setTimeout(() => { isRowSwipeInProgress = false; }, 90);
        };

        // Touch events (Mobile)
        document.addEventListener('touchstart', (e) => {
            lastTouchInteractionTime = Date.now();
            if (e.touches.length !== 1) return;
            handlePressStart(e.touches[0].clientX, e.touches[0].clientY, e.target, false);
        }, { passive: true });

        document.addEventListener('touchmove', (e) => {
            if (e.touches.length !== 1) return;
            handlePressMove(e.touches[0].clientX, e.touches[0].clientY, e);
        }, { passive: false });

        document.addEventListener('touchend', handlePressEnd, { passive: true });
        document.addEventListener('touchcancel', handlePressEnd, { passive: true });

        // Mouse events (PC support)
        document.addEventListener('mousedown', (e) => {
            if (e.button !== 0) return; // Only left click
            handlePressStart(e.clientX, e.clientY, e.target, true);
        });

        document.addEventListener('mousemove', (e) => {
            if (e.buttons === 1 || isHoldArmed || swipingTr) {
                handlePressMove(e.clientX, e.clientY, e);
            }
        });

        document.addEventListener('mouseup', handlePressEnd);

        // Prevent accidental clicks after swiping
        document.addEventListener('click', (e) => {
            if (isRowSwipeInProgress || (Date.now() - lastSwipeTimestamp < 300)) {
                e.stopPropagation();
                e.preventDefault();
            }
        }, true);

        // Prevent native text selection / image dragging during swipe
        document.addEventListener('dragstart', (e) => {
            if (candidateTr || swipingTr || isHoldArmed) {
                e.preventDefault();
            }
        });
        document.addEventListener('selectstart', (e) => {
            if (candidateTr || swipingTr || isHoldArmed) {
                e.preventDefault();
            }
        });

        // Dynamic Auto-Hiding Scrollbar
        let globalScrollTimer = null;
        window.addEventListener('scroll', () => {
            if (!document.body.classList.contains('is-scrolling')) {
                document.body.classList.add('is-scrolling');
            }
            if (globalScrollTimer) clearTimeout(globalScrollTimer);
            globalScrollTimer = setTimeout(() => {
                document.body.classList.remove('is-scrolling');
            }, 750);
        }, { passive: true, capture: true });
    }

    function initSmartHaptics() {
        const releaseTouched = () => {
            document.querySelectorAll('.is-touched').forEach(el => {
                const pressTime = Number(el.dataset.pressTime || 0);
                const elapsed = Date.now() - pressTime;
                const minHold = 90; // ensures the eye perceives the physical press even on 20ms micro-taps
                const delay = Math.max(0, minHold - elapsed);
                if (delay > 0) {
                    setTimeout(() => {
                        el.classList.remove('is-touched');
                        delete el.dataset.pressTime;
                    }, delay);
                } else {
                    el.classList.remove('is-touched');
                    delete el.dataset.pressTime;
                }
            });
        };

        document.addEventListener('pointerdown', (e) => {
            const target = e.target.closest('button, .tab-btn, .filter-chip, .dash-card, .badge-position, .tag-customer, .add-customer-chip, .top-icon-btn, .auth-btn, .superuser-badge-btn, .comment-item, .toggle-accordion-btn, .edit-btn, .comment-btn, .floating-corner-btn, .floating-corner-btn-left, .mold-clickable-id');
            if (target) {
                if (target.matches('.tab-btn, .filter-chip, .badge-position, .tag-customer')) {
                    haptic.selection();
                } else {
                    haptic.impact();
                }
                if (!target.classList.contains('toggle-accordion-btn')) {
                    target.dataset.pressTime = Date.now();
                    target.classList.add('is-touched');
                }
            }
        }, { passive: true });

        document.addEventListener('pointerup', releaseTouched, { passive: true });
        document.addEventListener('pointercancel', releaseTouched, { passive: true });
        document.addEventListener('touchend', releaseTouched, { passive: true });
        document.addEventListener('touchcancel', releaseTouched, { passive: true });
    }

