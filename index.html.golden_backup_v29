    function getShiftPlanStorageKey() {
        return 'adis_shift_plan_' + (currentUser ? encodeURIComponent(currentUser.trim()) : 'default');
    }

    function loadShiftPlan() {
        try {
            const raw = localStorage.getItem(getShiftPlanStorageKey());
            if (raw) {
                const parsed = JSON.parse(raw);
                if (Array.isArray(parsed)) {
                    currentShiftPlan = parsed.map(item => {
                        const cleanNum = String(item.num || '').trim();
                        const mold = cleanNum ? rawDatabase.find(m => String(m[0]).trim() === cleanNum) : null;
                        return {
                            id: item.id || (cleanNum ? ('mold_' + cleanNum) : ('task_' + (item.machine || '') + '_' + Date.now())),
                            num: cleanNum,
                            machine: String(item.machine || '').trim(),
                            pos: mold ? (mold[1] || item.pos || 'Mezisklad') : (item.pos || (cleanNum ? 'Mezisklad' : 'Lis')),
                            customer: mold ? (mold[2] || item.customer || '') : (item.customer || ''),
                            product: mold ? (mold[5] || item.product || '') : (item.product || ''),
                            pokracovani: Boolean(item.pokracovani),
                            pokracovaniTime: item.pokracovaniTime || '',
                            rozjezd: Boolean(item.rozjezd),
                            rozjezdTime: item.rozjezdTime || '',
                            checked: Boolean(item.checked),
                            addedAt: item.addedAt || Date.now()
                        };
                    }).filter(item => Boolean(item.num || item.machine || item.pokracovani || item.rozjezd));
                } else {
                    currentShiftPlan = [];
                }
            } else {
                currentShiftPlan = [];
            }
        } catch (e) {
            console.warn('Shift plan load error:', e);
            currentShiftPlan = [];
        }
        updateShiftPlanBadge();
    }

    function saveShiftPlan() {
        try {
            localStorage.setItem(getShiftPlanStorageKey(), JSON.stringify(currentShiftPlan));
        } catch (e) {
            console.warn('Shift plan save error:', e);
        }
        updateShiftPlanBadge();
    }

    function updateShiftPlanBadge() {
        const badge = document.getElementById('shiftPlanBadge');
        if (!badge) return;
        const total = currentShiftPlan.length;
        if (total === 0) {
            badge.style.display = 'none';
            badge.classList.remove('all-done');
            badge.textContent = '0';
        } else {
            const checked = currentShiftPlan.filter(item => item.checked).length;
            badge.style.display = 'inline-flex';
            badge.textContent = total > 1 ? `${checked}/${total}` : (checked ? '✓' : '1');
            if (checked === total && total > 0) {
                badge.classList.add('all-done');
            } else {
                badge.classList.remove('all-done');
            }
        }
    }

