        .header-buttons-right {
            position: absolute;
            top: 0.75rem;
            right: 0.75rem;
            display: flex;
            gap: 0.4rem;
            z-index: 20;
        }

        .header-auth-left {
            position: absolute;
            top: 0.75rem;
            left: 0.75rem;
