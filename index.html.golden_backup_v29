    let scannerSelectedBatchMoldIds = new Set();

    function handleBatchMoldMatchFound(molds) {
        if (!molds || molds.length === 0) return;
        isScannerLocked = true;

        // Merge new molds with existing batch molds so scanning along a sheet accumulates all molds
        const existingMap = new Map(scannerBatchMolds.map(m => [String(m[0]), m]));
        molds.forEach(m => {
            const idStr = String(m[0]);
            if (!existingMap.has(idStr)) {
                existingMap.set(idStr, m);
                scannerSelectedBatchMoldIds.add(idStr);
            }
        });

        scannerBatchMolds = Array.from(existingMap.values());
        scannerBatchMolds.forEach(m => scannerSelectedBatchMoldIds.add(String(m[0])));

        haptic.cameraSuccess();
        playScannerAudioBeep(true);

        const reticle = document.getElementById('scannerReticle');
        if (reticle) {
            reticle.classList.add('matched');
            reticle.classList.add('matched-multi');
        }

        const count = scannerBatchMolds.length;
        const countStr = count === 1 ? 'forma' : (count < 5 ? 'formy' : 'forem');

        const statusText = document.getElementById('scannerStatusText');
        if (statusText) {
            statusText.textContent = `Denní plán: nalezeno ${count} ${countStr}`;
        }

        const singleView = document.getElementById('scannerSingleResultView');
        const multiView = document.getElementById('scannerMultiResultView');
        const batchView = document.getElementById('scannerBatchResultView');

        if (singleView) singleView.style.display = 'none';
        if (multiView) multiView.style.display = 'none';
        if (batchView) batchView.style.display = 'block';

        const drawer = document.getElementById('scannerResultDrawer');
        if (drawer) {
            drawer.classList.add('multi-mode');
            drawer.classList.add('active');
        }

        const badge = document.getElementById('scannerBatchResultBadge');
        if (badge) {
            badge.textContent = `✓ Nalezeno ${count} ${countStr} v denním plánu`;
        }

        renderBatchList();
    }

