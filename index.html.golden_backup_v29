    async function fitPdfWidth() {
        if (!currentPdfDoc) return;
        try {
            const page = await currentPdfDoc.getPage(currentPdfPage);
            const scrollArea = document.getElementById('pdfScrollArea');
            const availWidth = (scrollArea ? scrollArea.clientWidth : window.innerWidth) - 32;
            const unscaledViewport = page.getViewport({ scale: 1.0, rotation: pdfRotationAngle });
            const desiredScale = Math.max(0.4, Math.min(2.5, availWidth / unscaledViewport.width));
            pdfZoomScale = desiredScale;
            queueRenderPdfPage(currentPdfPage);
        } catch (e) {
            pdfZoomScale = 1.0;
            queueRenderPdfPage(currentPdfPage);
        }
    }

