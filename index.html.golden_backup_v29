    function updateMachineMoldSuggestions(query) {
        const suggEl = document.getElementById('machineMoldSuggestions');
        if (!suggEl) return;

        const q = String(query || '').trim().toLowerCase();
        if (!q) {
            closeMachineMoldSuggestions();
            return;
        }

        // Vyhledávání v platných formách podle čísla formy a názvu výrobku
        const matches = [];
        const seenMolds = new Set();

        // 1. Přesné a prefixové shody čísla formy nebo názvu
        for (let i = 0; i < rawDatabase.length; i++) {
            const mold = rawDatabase[i];
            if (mold[4]) continue; // vymazaná forma v koši

            const moldNum = String(mold[0] || '').trim();
            const prodName = String(mold[5] || '').trim();
            const cust = String(mold[2] || '').trim();
            const pos = String(mold[1] || '').trim();

            if (!moldNum || seenMolds.has(moldNum)) continue;

            const moldNumLow = moldNum.toLowerCase();
            const prodNameLow = prodName.toLowerCase();

            let score = 0;
            if (moldNumLow === q) {
                score = 100;
            } else if (moldNumLow.startsWith(q)) {
                score = 80;
            } else if (prodNameLow.startsWith(q)) {
                score = 70;
            } else if (prodNameLow.includes(q)) {
                score = 50;
            } else if (moldNumLow.includes(q)) {
                score = 40;
            }

            if (score > 0) {
                seenMolds.add(moldNum);
                matches.push({
                    num: moldNum,
                    product: prodName || 'Bez názvu',
                    customer: cust,
                    position: pos,
                    score
                });
            }
        }

        matches.sort((a, b) => b.score - a.score || a.num.localeCompare(b.num, undefined, { numeric: true }));
        machineMoldCurrentMatches = matches.slice(0, 8);
        machineMoldActiveIndex = -1;

        if (machineMoldCurrentMatches.length === 0) {
            suggEl.innerHTML = `
                <div style="padding: 8px 10px; font-size: 0.76rem; color: #94a3b8; font-style: italic; text-align: center;">
                    Žádná forma neodpovídá výrazu „${escapeHtml(query)}“
                </div>
            `;
            suggEl.style.display = 'block';
            return;
        }

        const safeQuery = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const highlightRegex = new RegExp(`(${safeQuery})`, 'gi');

        suggEl.innerHTML = machineMoldCurrentMatches.map((item, idx) => {
            const highlightedProduct = escapeHtml(item.product).replace(highlightRegex, '<span class="mach-mold-dropdown-highlight">$1</span>');
            const highlightedNum = escapeHtml(item.num).replace(highlightRegex, '<span class="mach-mold-dropdown-highlight">$1</span>');
            const custStyle = typeof getCustomerStyle === 'function' ? getCustomerStyle(item.customer) : '';

            return `
                <div class="mach-mold-dropdown-item" onmousedown="selectMachineMoldSuggestion('${escapeHtml(item.num)}')" data-index="${idx}">
                    <div class="mach-mold-dropdown-left">
                        <span class="mach-mold-dropdown-badge">#${highlightedNum}</span>
                        <span class="mach-mold-dropdown-product" title="${escapeHtml(item.product)}">${highlightedProduct}</span>
                    </div>
                    <div class="mach-mold-dropdown-right">
                        ${item.position ? `<span class="mach-mold-dropdown-pos">${escapeHtml(item.position)}</span>` : ''}
                        ${item.customer ? `<span class="tag-customer" style="${custStyle}; font-size: 0.64rem; padding: 0.05rem 0.35rem; border-radius: 3px; font-weight: 700;">${escapeHtml(item.customer)}</span>` : ''}
                    </div>
                </div>
            `;
        }).join('');

        suggEl.style.display = 'block';
    }

    function selectMachineMoldSuggestion(moldNum) {
        if (!checkAuthOrPrompt()) return;
        triggerHapticFeedback([12]);
        const input = document.getElementById('machineMoldInput');
        if (input) {
            input.value = moldNum;
            input.focus();
        }
        const clearBtn = document.getElementById('btnClearMachineMold');
        if (clearBtn) clearBtn.style.display = 'inline-flex';

        closeMachineMoldSuggestions();
        updateMachineMoldProductPreview(moldNum);
        saveMachineMoldNumber();
    }

    function handleMachineMoldInput() {
        const input = document.getElementById('machineMoldInput');
        const clearBtn = document.getElementById('btnClearMachineMold');
        const val = input ? input.value.trim() : '';
        if (clearBtn) {
            clearBtn.style.display = val.length > 0 ? 'inline-flex' : 'none';
        }
        updateMachineMoldProductPreview(val);
        updateMachineMoldSuggestions(val);
    }

    function clearMachineMoldInput() {
        if (!checkAuthOrPrompt()) return;
        triggerHapticFeedback([10]);
        const input = document.getElementById('machineMoldInput');
        if (input) {
            input.value = '';
            input.focus();
        }
        const clearBtn = document.getElementById('btnClearMachineMold');
        if (clearBtn) clearBtn.style.display = 'none';
        updateMachineMoldProductPreview('');

        const machine = factoryMachinesData.find(m => m.id === currentActiveMachineId);
        if (machine && machine.currentMold) {
            machine.currentMold = '';
            saveFactoryMachinesState();
            const goToMoldBtn = document.getElementById('btnGoToMachineMold');
            if (goToMoldBtn) goToMoldBtn.style.display = 'none';
            renderGraphicFactoryMap();
            showToast(`Forma odebrána z lisu ${machine.number}`);
        }
    }

    function saveMachineMoldNumber() {
        if (!checkAuthOrPrompt()) return;
        triggerHapticFeedback([15]);
        closeMachineMoldSuggestions();
        const machine = factoryMachinesData.find(m => m.id === currentActiveMachineId);
        if (!machine) return;

        const input = document.getElementById('machineMoldInput');
        let val = input ? input.value.trim() : '';

        // Pokud uživatel zadal název výrobku (nebo část) namísto čísla, najdeme odpovídající formu
        if (val && !rawDatabase.some(m => String(m[0]).trim().toLowerCase() === val.toLowerCase() && !m[4])) {
            const foundByProduct = rawDatabase.find(m => !m[4] && String(m[5] || '').trim().toLowerCase() === val.toLowerCase()) ||
                                   rawDatabase.find(m => !m[4] && String(m[5] || '').trim().toLowerCase().includes(val.toLowerCase()));
            if (foundByProduct) {
                val = String(foundByProduct[0]).trim();
                if (input) input.value = val;
            }
        }

        machine.currentMold = val;
        saveFactoryMachinesState();
        updateMachineMoldProductPreview(val);

        const clearMoldBtn = document.getElementById('btnClearMachineMold');
        if (clearMoldBtn) clearMoldBtn.style.display = val ? 'inline-flex' : 'none';

        const goToMoldBtn = document.getElementById('btnGoToMachineMold');
        if (goToMoldBtn) goToMoldBtn.style.display = val ? 'inline-flex' : 'none';

        renderGraphicFactoryMap();
        showToast(val ? `Forma ${val} přiřazena k lisu ${machine.number}` : `Forma odebrána z lisu ${machine.number}`);
    }

    function navigateToMachineMold() {
        const machine = factoryMachinesData.find(m => m.id === currentActiveMachineId);
        if (!machine || !machine.currentMold) return;

        triggerHapticFeedback([15]);
        const moldNum = machine.currentMold;
        closeMachineDetailModal();
        closeFactoryMapPage();

        // Přepnout na záložku vyhledávání
        const btnSearch = document.getElementById('btn-search');
        if (btnSearch) btnSearch.click();

        const sInput = document.getElementById('searchInput');
        if (sInput) {
            sInput.value = moldNum;
            handleSearch();
            sInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    }

    function renderMachineIssuesList(machine) {
        const listContainer = document.getElementById('machineIssuesList');
        const badgeCount = document.getElementById('machineIssuesBadgeCount');
        if (!listContainer) return;

        const issues = machine.issues || [];
        const unresolvedCount = issues.filter(i => !i.resolved).length;
        if (badgeCount) badgeCount.textContent = `${issues.length} (${unresolvedCount} aktivních)`;

        if (issues.length === 0) {
            listContainer.innerHTML = `
                <div style="padding: 1rem; text-align: center; color: var(--text-muted); font-size: 0.82rem; background: var(--input-bg); border-radius: 6px; border: 1px dashed var(--border-color);">
                    Žádné zapsané závady ani servisní záznamy.
                </div>
            `;
            return;
        }

        listContainer.innerHTML = issues.map((issue) => {
            const isCritical = issue.priority === 'critical';
            const isResolved = !!issue.resolved;

            let dateFormatted = '';
            try {
                const d = new Date(issue.date);
                dateFormatted = `${d.getDate()}.${d.getMonth() + 1}. ${d.getHours()}:${String(d.getMinutes()).padStart(2, '0')}`;
            } catch { dateFormatted = issue.date || ''; }

            return `
                <div style="background: ${isResolved ? 'var(--input-bg)' : (isCritical ? '#fef2f2' : 'var(--card-bg)')}; border: 1px solid ${isResolved ? 'var(--border-color)' : (isCritical ? '#fca5a5' : 'var(--border-color)')}; border-radius: 6px; padding: 0.65rem; display: flex; flex-direction: column; gap: 0.35rem; opacity: ${isResolved ? '0.6' : '1'};">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div style="display: flex; align-items: center; gap: 0.45rem;">
                            <span style="font-size: 0.68rem; font-weight: 800; padding: 0.1rem 0.35rem; border-radius: 4px; background: ${isCritical ? '#dc2626' : '#64748b'}; color: #ffffff; text-transform: uppercase;">
                                ${isCritical ? '⚠️ Kritická' : 'Běžná'}
                            </span>
                            <span style="font-size: 0.74rem; font-weight: 700; color: var(--text-main);">${escapeHtml(issue.author || 'Seřizovač')}</span>
                            <span style="font-size: 0.7rem; color: var(--text-muted);">${dateFormatted}</span>
                        </div>
                        <button type="button" onclick="deleteMachineIssue(${issue.id})" style="background: none; border: none; color: #dc2626; font-size: 0.8rem; cursor: pointer; padding: 0 0.25rem;" title="Smazat záznam">✕</button>
                    </div>

                    <div style="font-size: 0.82rem; color: var(--text-main); font-weight: 500; ${isResolved ? 'text-decoration: line-through;' : ''}">
                        ${escapeHtml(issue.text)}
                    </div>

                    <div style="display: flex; justify-content: flex-end; align-items: center; margin-top: 0.2rem;">
                        <button type="button" class="btn-secondary" onclick="toggleMachineIssueResolved(${issue.id})" style="padding: 0.2rem 0.55rem; font-size: 0.72rem; font-weight: 700; display: flex; align-items: center; gap: 0.25rem;">
                            ${isResolved ? '↩ Vrátit mezi aktivní' : '✓ Označit jako vyřešené'}
                        </button>
                    </div>
                </div>
            `;
        }).join('');
    }

    function addNewMachineIssue() {
        if (!checkAuthOrPrompt()) return;
        triggerHapticFeedback([15]);
        const machine = factoryMachinesData.find(m => m.id === currentActiveMachineId);
        if (!machine) return;

        const textInput = document.getElementById('newIssueTextInput');
        const text = textInput ? textInput.value.trim() : '';
        if (!text) {
            showToast('Zadejte popis závady', true);
            return;
        }

        const priorityRadio = document.querySelector('input[name="issuePriority"]:checked');
        const priority = priorityRadio ? priorityRadio.value : 'normal';

        if (!Array.isArray(machine.issues)) machine.issues = [];

        const newIssue = {
            id: Date.now(),
            text: text,
            priority: priority,
            author: currentUser || 'Seřizovač',
            date: new Date().toISOString(),
            resolved: false
        };

        machine.issues.unshift(newIssue);

        // Pokud je závada kritická a stroj byl 'ok', přepnout na 'error'
        if (priority === 'critical' && machine.status === 'ok') {
            machine.status = 'error';
            updateMachineStatusButtonsUI('error');
        }

        saveFactoryMachinesState();
        textInput.value = '';

        renderMachineProblemStatusBanner(machine);
        renderMachineIssuesList(machine);
        renderGraphicFactoryMap();

        showToast('Závada byla zaznamenána do knihy lisu');
    }

    function toggleMachineIssueResolved(issueId) {
        if (!checkAuthOrPrompt()) return;
        triggerHapticFeedback([12]);
        const machine = factoryMachinesData.find(m => m.id === currentActiveMachineId);
        if (!machine || !Array.isArray(machine.issues)) return;

        const issue = machine.issues.find(i => i.id === issueId);
        if (!issue) return;

        issue.resolved = !issue.resolved;
        saveFactoryMachinesState();

        renderMachineProblemStatusBanner(machine);
        renderMachineIssuesList(machine);
        renderGraphicFactoryMap();

        showToast(issue.resolved ? 'Závada označena jako vyřešená' : 'Závada vrácena mezi aktivní');
    }

    function deleteMachineIssue(issueId) {
        if (!checkAuthOrPrompt()) return;
        triggerHapticFeedback([12]);
        const machine = factoryMachinesData.find(m => m.id === currentActiveMachineId);
        if (!machine || !Array.isArray(machine.issues)) return;

        machine.issues = machine.issues.filter(i => i.id !== issueId);
        saveFactoryMachinesState();

        renderMachineProblemStatusBanner(machine);
        renderMachineIssuesList(machine);
        renderGraphicFactoryMap();

        showToast('Záznam smazán');
    }
    document.addEventListener('click', (e) => {
        const input = document.getElementById('machineMoldInput');
        const sugg = document.getElementById('machineMoldSuggestions');
        if (sugg && sugg.style.display === 'block') {
            if (!sugg.contains(e.target) && e.target !== input) {
                closeMachineMoldSuggestions();
            }
        }
    });
</script>
</body>
</html>