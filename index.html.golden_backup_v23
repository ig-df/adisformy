    const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function renderEmailSlots(mode, savedEmails = []) {
        const container = document.getElementById(`${mode}EmailContainer`);
        const addBtn = document.getElementById(`${mode}AddEmailBtn`);
        if (!container) return;

        if (savedEmails.length === 0) {
            container.innerHTML = `
                <div style="font-size: 0.78rem; color: var(--text-muted); font-style: italic; padding: 0.2rem 0;">
                    ${mode === 'auto' ? 'Automatické odesílání je vypnuto (žádné e-mailové adresy).' : 'Seznam e-mailových adres je prázdný.'}
                </div>
            `;
            if (addBtn) addBtn.style.display = 'inline-block';
            return;
        }

        container.innerHTML = savedEmails.map((email, idx) => {
            return `
                <div class="email-input-container" id="${mode}Slot_${idx}">
                    <input type="email" id="${mode}EmailInput_${idx}" class="email-compact-input" value="${escapeHtml(email)}" placeholder="e-mail@firma.cz" autocomplete="off">
                    <div class="email-inline-icons">
                        <button type="button" class="email-icon-btn email-icon-check" onclick="confirmEmailSlot('${mode}', ${idx})" title="Potvrdit e-mail">✓</button>
                        <button type="button" class="email-icon-btn email-icon-cross" onclick="removeEmailSlot('${mode}', ${idx})" title="Smazat e-mail">✕</button>
                    </div>
                </div>
            `;
        }).join('');

        if (addBtn) {
            addBtn.style.display = savedEmails.length >= 4 ? 'none' : 'inline-block';
        }
    }

    function confirmEmailSlot(mode, idx) {
        triggerHapticFeedback([12]);
        const input = document.getElementById(`${mode}EmailInput_${idx}`);
        if (input) {
            const val = input.value.trim();
            if (!val) {
                alert("Zadejte e-mailovou adresu!");
                return;
            }
            if (!EMAIL_REGEX.test(val)) {
                alert("Neplatný formát e-mailové adresy!");
                return;
            }
            saveEmailsToLocalStorage(mode);
            showToast("E-mail byl uložen");
            input.blur();
        }
    }

    function addEmailSlot(mode) {
        triggerHapticFeedback([12]);
        const container = document.getElementById(`${mode}EmailContainer`);
        if (!container) return;
        const currentInputs = container.querySelectorAll('input[type="email"]');
        let currentEmails = Array.from(currentInputs).map(inp => inp.value.trim());
        currentEmails.push("");
        renderEmailSlots(mode, currentEmails);
        
        const newIdx = currentEmails.length - 1;
        const newInput = document.getElementById(`${mode}EmailInput_${newIdx}`);
        if (newInput) {
            newInput.focus();
            container.scrollTop = container.scrollHeight;
        }
    }

    function removeEmailSlot(mode, idx) {
        triggerHapticFeedback([12]);
        const container = document.getElementById(`${mode}EmailContainer`);
        if (!container) return;
        const currentInputs = container.querySelectorAll('input[type="email"]');
        let currentEmails = Array.from(currentInputs).map(inp => inp.value.trim());
        currentEmails.splice(idx, 1);
        
        renderEmailSlots(mode, currentEmails);
        saveEmailsToLocalStorage(mode);
        showToast("E-mail byl smazán");
    }

    async function saveEmailsToLocalStorage(mode) {
        const emails = getEmailsFromContainer(mode);
        const key = mode === 'inst' ? 'adis_inst_emails' : 'adis_auto_emails';
        
        localStorage.setItem(key, JSON.stringify(emails));
        
        try {
            await supabaseClient
                .from('app_settings')
                .upsert([{ key: key, value: JSON.stringify(emails) }], { onConflict: 'key' });
        } catch (err) {
            console.error("Chyba při ukládání e-mailů do Supabase:", err);
        }
    }

    function getEmailsFromContainer(mode) {
        const container = document.getElementById(`${mode}EmailContainer`);
        if (!container) return [];
