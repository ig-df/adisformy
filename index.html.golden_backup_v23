            currentNavodky = navodkaUrl.startsWith("[") ? JSON.parse(navodkaUrl) : (navodkaUrl ? [{url: navodkaUrl, title: "Návodka 1"}] : []);
        } catch(e) { currentNavodky = navodkaUrl ? [{url: navodkaUrl, title: "Návodka 1"}] : []; }

        const pendingNavodkyFiles = temporaryNavodkaMap[moldId] || [];

        if (replaceNavodkaMap[moldId]) {
            for (let idxStr in replaceNavodkaMap[moldId]) {
                const idx = parseInt(idxStr, 10);
                const file = replaceNavodkaMap[moldId][idx];
                if (file && currentNavodky[idx]) {
                    const cleanOrigName = sanitizeFileName(file.name || "navodka.pdf");
                    const fileName = `navodka_${moldId}_${Date.now()}_${cleanOrigName}`;
                    const { error } = await supabaseClient.storage.from('mold-photos').upload(fileName, file, { upsert: true });
                    if (!error) {
                        const { data } = supabaseClient.storage.from('mold-photos').getPublicUrl(fileName);
                        const fileTitle = getTitleFromFilename(file.name, idx + 1);
                        currentNavodky[idx] = { url: data.publicUrl, title: fileTitle };
                    }
                }
            }
