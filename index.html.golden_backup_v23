            .floating-corner-btn { position: absolute; bottom: 1.25rem; right: 1.25rem; }
            .floating-corner-btn-left { position: absolute; bottom: 1.25rem; left: 1.25rem; }
        }

        @media (max-width: 600px) {
            .floating-corner-btn { 
                position: fixed !important; 
                right: 1.25rem !important; 
                bottom: max(1.25rem, env(safe-area-inset-bottom, 1.25rem)) !important; 
            }
            .floating-corner-btn-left { 
                position: fixed !important; 
                left: 1.25rem !important; 
                bottom: max(1.25rem, env(safe-area-inset-bottom, 1.25rem)) !important; 
            }
        }

        .helios-accordion-card {
            border: 1px solid var(--border-color);
            border-radius: 10px;
            overflow: hidden;
            background: var(--card-bg);
            transition: border-color 0.2s ease;
        }
        .helios-accordion-header {
            padding: 0.8rem 1rem;
            background: var(--row-hover);
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.88rem;
            color: var(--text-main);
            transition: background 0.2s ease;
        }
        .helios-accordion-header:hover {
            background-color: var(--border-color);
        }
        .helios-accordion-header-left {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .helios-accordion-header-left svg {
            width: 18px;
            height: 18px;
            stroke: var(--text-main);
            fill: none;
            stroke-width: 1.8;
            flex-shrink: 0;
        }
        
        .helios-accordion-arrow {
            font-size: 0.75rem;
            color: var(--text-muted);
            transform: rotate(0deg) translateZ(0);
            -webkit-transform: rotate(0deg) translateZ(0);
            transform-origin: 50% 50%;
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
            will-change: transform, color;
            transition: transform 0.42s cubic-bezier(0.34, 1.25, 0.64, 1), 
                        -webkit-transform 0.42s cubic-bezier(0.34, 1.25, 0.64, 1), 
                        color 0.38s ease;
        }
        .helios-accordion-card.open .helios-accordion-arrow {
            transform: rotate(180deg) translateZ(0);
            -webkit-transform: rotate(180deg) translateZ(0);
            color: var(--text-main);
        }

        .helios-accordion-anim-wrapper {
            display: grid;
            grid-template-rows: 0fr;
            opacity: 0;
            transition: grid-template-rows 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease-out;
            overflow: hidden;
            background: var(--card-bg);
            border-top: 1px solid transparent;
        }
        .helios-accordion-card.open .helios-accordion-anim-wrapper {
            grid-template-rows: 1fr;
            opacity: 1;
            border-top-color: var(--border-color);
        }
        
        .helios-accordion-anim-wrapper > div {
            min-height: 0;
            padding: 0.85rem 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.65rem;
            -webkit-overflow-scrolling: touch;
        }

        @media (max-width: 600px) {
            .helios-accordion-card.open .helios-accordion-anim-wrapper > div {
                max-height: 55vh;
                overflow-y: auto !important;
                padding-bottom: 1.2rem !important;
            }
        }

        .helios-export-grid {
            display: grid;
            grid-template-columns: 1fr 1fr !important;
            gap: 0.5rem;
            margin-bottom: 0.4rem;
        }

        .helios-action-btn {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 0.35rem 0.5rem;
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--text-main);
            cursor: pointer;
            text-align: center;
            display: flex;
            flex-direction: row !important;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            height: 38px;
            box-shadow: 0 1px 2px rgba(0,0,0,0.04);
            transition: all 0.2s ease;
        }

        .helios-action-btn:hover {
            background-color: var(--row-hover);
            border-color: var(--text-muted);
            transform: translateY(-1px);
        }

        .helios-action-btn img, 
        .helios-action-btn svg {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }

        .selectable-btn {
            position: relative;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .selectable-btn.selected {
            border-color: #22c55e !important;
            background-color: #f0fdf4 !important;
            box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.2);
        }
        .selectable-btn.selected::after {
            content: '✓';
            position: absolute;
            top: 5px;
            right: 6px;
            background-color: #22c55e;
            color: #ffffff;
            font-size: 10px;
            font-weight: bold;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 1px 2px rgba(0,0,0,0.15);
        }

        .email-list-scroll-box {
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
            padding-right: 2px;
        }

        .email-input-container {
            position: relative;
            display: inline-flex;
            align-items: center;
            width: 100%;
        }

        .email-compact-input {
            width: 100%;
            padding: 0.28rem 0.6rem;
            font-size: 0.85rem;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            background-color: #f1f5f9;
            color: var(--text-muted);
            outline: none;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .email-compact-input:not(:focus):not(:active) {
            background-color: #f1f5f9 !important;
            color: var(--text-muted) !important;
            border-color: var(--border-color) !important;
        }

        .email-compact-input:focus {
            background-color: var(--input-bg) !important;
            color: var(--text-main) !important;
            border-color: #3b82f6 !important;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.15);
            padding-right: 3.8rem;
        }

        .email-inline-icons {
            display: none;
            position: absolute;
            right: 6px;
            align-items: center;
            gap: 2px;
            z-index: 5;
        }

        .email-input-container:focus-within .email-inline-icons {
            display: flex;
        }

        .email-icon-btn {
            background: none;
            border: none;
            width: 20px;
            height: 20px;
            border-radius: 4px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: bold;
            transition: background 0.15s ease, transform 0.1s ease;
        }

        .email-icon-btn:hover {
            background-color: rgba(0, 0, 0, 0.08);
            transform: scale(1.1);
        }

        .email-icon-check {
            color: #16a34a;
        }

        .email-icon-cross {
            color: #dc2626;
        }

        .add-email-link {
