            const cleanOrigName = sanitizeFileName(file.name || "photo.jpg");
            const fileName = `${moldId}_${Date.now()}_${cleanOrigName}`;
            const { error } = await supabaseClient.storage.from('mold-photos').upload(fileName, file, { upsert: true });
