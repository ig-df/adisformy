    async function fetchData() {
        try {
            await fetchCustomers();
            const [moldsRes, commentsRes] = await Promise.all([
                fetch(`${API_URL}/rest/v1/molds?select=*`, { headers: { 'apikey': API_KEY, 'Authorization': `Bearer ${API_KEY}` } }),
                fetch(`${API_URL}/rest/v1/mold_comments?select=*&order=created_at.desc`, { headers: { 'apikey': API_KEY, 'Authorization': `Bearer ${API_KEY}` } }).catch(() => null)
            ]);

            if (!moldsRes.ok) throw new Error("Chyba API");
            const data = await moldsRes.json();
            
            rawDatabase = data.map(item => {
                let photosArr = [];
                if (item.photo_url) {
                    try {
                        const parsed = JSON.parse(item.photo_url);
                        photosArr = Array.isArray(parsed) ? parsed : [item.photo_url];
                    } catch { photosArr = [item.photo_url]; }
                }
                return [
                    item.id, item.position || '', item.customer || 'Others',
                    item.status || '', item.is_deleted || false, item.product_name || '',
                    photosArr, item.navodka_url || '', item.previous_position || ''
                ];
            }).sort((a, b) => String(a[0]).localeCompare(String(b[0]), undefined, { numeric: true, sensitivity: 'base' }));

            if (commentsRes && commentsRes.ok) {
                const loadedComments = await commentsRes.json();
                allComments = loadedComments.map(c => {
                    let parsedPhotoUrls = [];
                    if (c.photo_urls) {
                        if (Array.isArray(c.photo_urls)) parsedPhotoUrls = c.photo_urls;
                        else if (typeof c.photo_urls === 'string') {
                            try {
                                const parsed = JSON.parse(c.photo_urls);
                                parsedPhotoUrls = Array.isArray(parsed) ? parsed : [c.photo_urls];
                            } catch { parsedPhotoUrls = [c.photo_urls]; }
                        }
                    }
                    return { ...c, photo_urls: parsedPhotoUrls };
                });
            }

            refreshUI();
        } catch (e) { console.error("Fetch error:", e); }
    }

    function toggleAccordion(rowKey, moldId) {
        let floatingLayer = document.getElementById(`accordion-floating-${rowKey}`);
        const btn = document.getElementById(`accordion-btn-${rowKey}`);
        const isExpanded = Boolean(expandedMoldsMap[rowKey]);

        const triggerTr = document.getElementById(`accordion-trigger-${rowKey}`);
        const tableContainer = triggerTr ? triggerTr.closest('.table-container') : (floatingLayer ? floatingLayer.closest('.table-container') : null);
        const currentScrollTop = tableContainer ? tableContainer.scrollTop : 0;

        if (isExpanded) {
            expandedMoldsMap[rowKey] = false;
            if (btn) btn.classList.remove('expanded');

            if (temporaryFilesMap[moldId]) {
                temporaryFilesMap[moldId].forEach(f => { if (f._previewUrl) URL.revokeObjectURL(f._previewUrl); });
            }
            
            if (floatingLayer) {
                const wrapper = document.getElementById(`accordion-wrap-${rowKey}`);
                if (wrapper) wrapper.classList.remove('open');
                floatingLayer.classList.remove('open');

                if (tableContainer) {
                    tableContainer.style.minHeight = '';
                    tableContainer.scrollTop = currentScrollTop;
                }
                
                setTimeout(() => {
                    if (tableContainer) tableContainer.scrollTop = currentScrollTop;
                    floatingLayer.remove();
                    delete editingAccordionMap[moldId];
                    delete temporaryFilesMap[moldId];
                    delete temporaryNavodkaMap[moldId];
                    delete replaceNavodkaMap[moldId];
                    if (tableContainer) tableContainer.scrollTop = currentScrollTop;
                }, 470);
            }
        } else {
            Object.keys(expandedMoldsMap).forEach(id => {
                if (expandedMoldsMap[id] && id !== String(rowKey)) toggleAccordion(id, id.split('_').pop());
            });
            expandedMoldsMap[rowKey] = true;
            if (btn) btn.classList.add('expanded');

            logUserAction(moldId, 'Detail formy', 'Otevřen detail formy');

            const item = rawDatabase.find(i => String(i[0]) === String(moldId));
            
            if (item && triggerTr) {
                if (!floatingLayer) {
                    const html = `
                        <div id="accordion-floating-${escapeHtml(rowKey)}" class="accordion-floating-layer" style="z-index: 500;">
                            <div id="accordion-wrap-${escapeHtml(rowKey)}" class="accordion-anim-wrapper">
                                <div class="accordion-content" id="accordion-content-box-${escapeHtml(rowKey)}">
                                    ${renderAccordionInnerContent(item, rowKey)}
                                </div>
                            </div>
                        </div>
                    `;
                    tableContainer.insertAdjacentHTML('beforeend', html);
                    floatingLayer = document.getElementById(`accordion-floating-${rowKey}`);
                }

                if (tableContainer && floatingLayer) {
                    floatingLayer.style.width = `${tableContainer.clientWidth}px`;
                    const topPos = triggerTr.offsetTop + triggerTr.offsetHeight;
                    const leftPos = triggerTr.offsetLeft;

                    floatingLayer.style.top = `${topPos}px`;
                    floatingLayer.style.left = `${leftPos}px`;

                    tableContainer.style.minHeight = '';
                    tableContainer.scrollTop = currentScrollTop;
                }

                floatingLayer.style.display = 'block';
                
                requestAnimationFrame(() => {
                    if (tableContainer) tableContainer.scrollTop = currentScrollTop;
                    floatingLayer.classList.add('open');
                    const wrapper = document.getElementById(`accordion-wrap-${rowKey}`);
                    if (wrapper) wrapper.classList.add('open');
                    if (tableContainer) tableContainer.scrollTop = currentScrollTop;
                });
            }
        }
    }

