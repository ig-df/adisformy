    async function openUserActivityModal(userName, deviceType = '', lastSeenIso = '') {
        triggerHapticFeedback([12]);
        closeOnlineUsersPopover();

        currentUserActivityTarget = userName;
        currentUserActivityFilter = 'ALL';

        // Load logs in real-time first so there is zero flickering or counter resetting
        let logs = [];
        try {
            const { data: logsExact, error: errExact } = await supabaseClient
                .from('mold_logs')
                .select('*')
                .eq('user_name', userName)
                .order('created_at', { ascending: false })
                .limit(250);

            if (!errExact && logsExact) {
                logs = logsExact;
            }

            if (logs.length === 0) {
                const { data: logsIlike } = await supabaseClient
                    .from('mold_logs')
                    .select('*')
                    .ilike('user_name', `%${userName}%`)
                    .order('created_at', { ascending: false })
                    .limit(250);
                if (logsIlike && logsIlike.length > 0) {
                    logs = logsIlike;
                }
            }
        } catch(err) {
            console.error("Chyba při načítání aktivity uživatele:", err);
        }

        currentUserActivityData = logs || [];

        // Compute metrics directly with real data
        let totalCount = currentUserActivityData.length;
        let moveCount = 0;
        let searchCount = 0;
        let noteCount = 0;

        currentUserActivityData.forEach(item => {
            const moldIdStr = String(item.mold_id || '').toUpperCase();
            const oldPosStr = String(item.old_position || '').toLowerCase();
            const newPosStr = String(item.new_position || '').toLowerCase();

            if (moldIdStr === 'HLEDÁNÍ' || oldPosStr.includes('hled') || newPosStr.includes('hledal')) {
                searchCount++;
            } else if (oldPosStr.includes('koment') || oldPosStr.includes('foto') || newPosStr.includes('poznámk') || newPosStr.includes('fotograf')) {
                noteCount++;
            } else if (oldPosStr.includes('pozic') || newPosStr.includes('pozic') || oldPosStr.includes('stav') || newPosStr.includes('stav') || oldPosStr === 'položka vytvořena' || oldPosStr === 'koš') {
                moveCount++;
            }
        });

        // Set all modal header and metric DOM values synchronously to final values
        const titleEl = document.getElementById('userActivityTitle');
        const subtitleEl = document.getElementById('userActivitySubtitle');
        if (titleEl) titleEl.textContent = `Aktivita: ${userName}`;
        
        let subText = '';
        if (deviceType) subText += getDeviceBadgeHtml(deviceType);
        if (lastSeenIso) {
            const dateStr = new Date(lastSeenIso).toLocaleString('cs-CZ');
            if (subText) subText += `<span style="margin: 0 4px; opacity: 0.4;">•</span>`;
            subText += `<span>Poslední spojení: ${escapeHtml(dateStr)}</span>`;
        }
        if (subtitleEl) subtitleEl.innerHTML = subText;

        const filterBar = document.getElementById('uactFilterBar');
        if (filterBar) {
            filterBar.querySelectorAll('.filter-chip').forEach((btn, idx) => {
                btn.classList.toggle('active', idx === 0);
            });
        }

        const uTotal = document.getElementById('uactTotal');
        const uMoves = document.getElementById('uactMoves');
        const uSearches = document.getElementById('uactSearches');
        const uNotes = document.getElementById('uactNotes');
        if (uTotal) uTotal.textContent = totalCount;
        if (uMoves) uMoves.textContent = moveCount;
        if (uSearches) uSearches.textContent = searchCount;
        if (uNotes) uNotes.textContent = noteCount;

        const listEl = document.getElementById('userActivityList');
        if (listEl) {
            listEl.style.opacity = '1';
        }

        renderUserActivityList();

        // Show modal once content and metrics are 100% prepared
        showModalAnimated('userActivityModal');
    }

