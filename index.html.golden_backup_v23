            if (!error) {
                const { data } = supabaseClient.storage.from('mold-photos').getPublicUrl(fileName);
                const fileTitle = getTitleFromFilename(file.name, currentNavodky.length + 1);
                currentNavodky.push({ url: data.publicUrl, title: fileTitle });
            }
        }

        const finalNavodkaUrl = currentNavodky.length > 0 ? JSON.stringify(currentNavodky) : '';

        delete temporaryFilesMap[moldId];
        delete temporaryNavodkaMap[moldId];
        delete replaceNavodkaMap[moldId];
        delete editingAccordionMap[moldId];

        rawDatabase[itemIdx][5] = newProductName;
        rawDatabase[itemIdx][6] = photosArr;
        rawDatabase[itemIdx][7] = finalNavodkaUrl;
