                .select('last_seen');

            if (error || !sessions || sessions.length === 0) {
                badge.style.display = 'none';
                return;
            }

            const now = new Date();
            const activeIn24h = sessions.filter(session => {
                const lastSeen = new Date(session.last_seen);
                const diffMinutes = Math.floor((now - lastSeen) / 60000);
                return diffMinutes <= 1440;
            }).length;

            badge.style.display = activeIn24h > 0 ? 'block' : 'none';
        } catch (e) {
            console.warn("Badge calculation error:", e);
        }
    }

    let isOnlinePopoverClosing = false;

    function closeOnlineUsersPopover() {
        const popover = document.getElementById('onlineUsersPopover');
        const btn = document.getElementById('onlineUsersToggleBtn');
        const cleanupBtn = () => {
            if (btn) {
                btn.classList.remove('is-touched');
                if (typeof btn.blur === 'function') btn.blur();
            }
            document.querySelectorAll('.is-touched').forEach(el => el.classList.remove('is-touched'));
        };
        cleanupBtn();
        setTimeout(cleanupBtn, 50);
        setTimeout(cleanupBtn, 150);

        if (!popover || popover.style.display === 'none' || isOnlinePopoverClosing) return;
        isOnlinePopoverClosing = true;
        popover.classList.remove('popover-open');
        setTimeout(() => {
            popover.style.display = 'none';
            isOnlinePopoverClosing = false;
            cleanupBtn();
        }, 360);
    }

    function toggleOnlineUsersPopover(e) {
        e.stopPropagation();
        triggerHapticFeedback([12]);
        const popover = document.getElementById('onlineUsersPopover');
        const btn = document.getElementById('onlineUsersToggleBtn');
        
        const cleanupBtn = () => {
            if (btn) {
                btn.classList.remove('is-touched');
                if (typeof btn.blur === 'function') btn.blur();
            }
            document.querySelectorAll('.is-touched').forEach(el => el.classList.remove('is-touched'));
        };
        cleanupBtn();

        if (!popover || !btn) return;

        if (popover.classList.contains('popover-open')) {
            closeOnlineUsersPopover();
        } else {
            const rect = btn.getBoundingClientRect();
            popover.style.top = `${rect.bottom + window.scrollY + 6}px`;
            popover.style.left = `${Math.max(10, rect.left + window.scrollX - 100)}px`;
            popover.style.display = 'block';
            // Trigger reflow to apply smooth transition
            void popover.offsetWidth;
            popover.classList.add('popover-open');
            renderOnlineUsers();
            setTimeout(cleanupBtn, 80);
        }
    }

