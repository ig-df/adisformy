    async function fetchCustomers() {
        try {
            const res = await fetch(`${API_URL}/rest/v1/customers?select=*`, {
                headers: { 'apikey': API_KEY, 'Authorization': `Bearer ${API_KEY}` }
            });
            if (res.ok) {
                const data = await res.json();
                if (data && data.length > 0) {
                    let fetchedList = data.map(c => ({ name: c.name, bg: c.bg_color || '#ffffff' }));
                    const savedOrderJson = localStorage.getItem('adis_customers_order');
                    if (savedOrderJson) {
                        try {
                            const savedOrder = JSON.parse(savedOrderJson);
                            fetchedList.sort((a, b) => {
                                let indexA = savedOrder.indexOf(a.name);
                                let indexB = savedOrder.indexOf(b.name);
                                if (indexA === -1) indexA = 999;
                                if (indexB === -1) indexB = 999;
                                return indexA - indexB;
                            });
                        } catch (err) { console.error(err); }
                    }

                    const othersObj = fetchedList.find(c => c.name.toLowerCase() === 'others');
                    let listWithoutOthers = fetchedList.filter(c => c.name.toLowerCase() !== 'others');
                    if (othersObj) listWithoutOthers.push(othersObj);
                    else listWithoutOthers.push({ name: "Others", bg: "#fdfbf7" });
                    customersList = listWithoutOthers;
                }
            }
        } catch (e) { console.error("Error fetching customers:", e); }
    }

    let isCustomerDragging = false;
    let activeDragContainer = null;
    let customerDragStartX = 0;
    let customerDragScrollLeft = 0;
    let customerDragMoved = false;

    function initCustomerFiltersScrolling() {
        document.querySelectorAll('.customer-filters').forEach(container => {
            if (container.dataset.dragInitialized) return;
            container.dataset.dragInitialized = "true";

            container.addEventListener('mousedown', (e) => {
                if (e.button !== 0) return;
                isCustomerDragging = true;
                activeDragContainer = container;
                customerDragMoved = false;
                customerDragStartX = e.pageX;
                customerDragScrollLeft = container.scrollLeft;
            });

            container.addEventListener('wheel', (e) => {
                if (e.deltaY !== 0) {
                    container.scrollLeft += e.deltaY;
                }
            }, { passive: true });
        });

        window.addEventListener('mousemove', (e) => {
            if (!isCustomerDragging || !activeDragContainer) return;
            const walk = e.pageX - customerDragStartX;
            if (Math.abs(walk) > 4) {
                customerDragMoved = true;
                activeDragContainer.classList.add('is-dragging');
            }
            activeDragContainer.scrollLeft = customerDragScrollLeft - walk;
        });

        window.addEventListener('mouseup', () => {
            if (!isCustomerDragging) return;
            isCustomerDragging = false;
            if (activeDragContainer) {
                activeDragContainer.classList.remove('is-dragging');
                activeDragContainer = null;
            }
            if (customerDragMoved) {
                setTimeout(() => {
                    customerDragMoved = false;
                }, 60);
            }
        });
    }

