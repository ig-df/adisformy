    function renderStatusPill(status) {
        if (!status) return '';
        const s = String(status).toLowerCase();
        let dot = 'dot-red';
        if (s.includes('po údržbě') || s.includes('po udrzbe')) dot = 'dot-green';
        else if (s.includes('frontě na údržbu') || s.includes('fronte na udrzbe')) dot = 'dot-orange';
        else if (s.includes('frontě na opravu') || s.includes('fronte na opravu')) dot = 'dot-red';
        else if (s.includes('na opravě pryč') || s.includes('na oprave pryc')) dot = 'dot-red';
        else if (s.includes('na údržbě') || s.includes('na udrzbe') || s.includes('opravě')) dot = 'dot-yellow';
        return `<span class="status-pill"><span class="status-dot ${dot}"></span>${escapeHtml(status)}</span>`;
    }

