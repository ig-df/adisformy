        const query = document.getElementById('searchInput').value.trim().toLowerCase();
        const tbody = document.getElementById('searchResults');
        const stats = document.getElementById('searchStats');
        if (!tbody) return;

        if (!query) {
            stats.textContent = '';
            tbody.innerHTML = `<tr><td colspan="3" class="no-data-centered" style="text-align: center !important; color: var(--text-muted); font-size: 0.85rem; padding: 2rem 1rem !important;">Začněte psát do pole výše</td></tr>`;
            return;
        }

        const activeMolds = rawDatabase.filter(item => !item[4]);
        const matched = activeMolds.filter(item => {
            const [num, pos, cust, status, isDel, productName] = item;
            const matchId = String(num).toLowerCase().includes(query);
            const matchPos = String(pos).toLowerCase().includes(query);
            const matchCust = String(cust).toLowerCase().includes(query);
            const matchProd = String(productName || '').toLowerCase().includes(query);
            const matchStatus = String(status || '').toLowerCase().includes(query);
            return matchId || matchPos || matchCust || matchProd || matchStatus;
        });

        // Log search action with debounce to capture user intent without spamming
        clearTimeout(searchLogDebounceTimer);
        searchLogDebounceTimer = setTimeout(() => {
            if (query && query.length >= 2) {
                logUserAction('HLEDÁNÍ', 'Vyhledávání', `Hledal: "${query}" (${matched.length} výsledků)`);
            }
        }, 1800);

        stats.textContent = `Nalezeno výsledků: ${matched.length}`;

        if (matched.length === 0) {
            const cleanQuery = escapeHtml(document.getElementById('searchInput').value.trim());
            tbody.innerHTML = `
                <tr>
                    <td colspan="3" style="padding: 0 !important; background: transparent; border: none;">
                        <div class="empty-state-card">
                            <div class="empty-state-icon-box">
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="11" cy="11" r="8"></circle>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                </svg>
                            </div>
                            <div class="empty-state-title">Forma <span class="highlight-mold">#${cleanQuery}</span> nebyla nalezena</div>
                            <div class="empty-state-desc">V evidenci zatím neexistuje záznam odpovídající tomuto číslu nebo výrazu.</div>
                            <button type="button" class="empty-state-btn" onclick="openAddModal('${cleanQuery.replace(/'/g, "\\'")}')">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                <span>Přidat formu</span>
                            </button>
                        </div>
                    </td>
                </tr>
            `;
            return;
        }

        tbody.innerHTML = matched.map((item, idx) => {
            const [num, pos, cust, status, isDel, productName, photosArr, navodkaUrl, prevPos] = item;
            const custStyle = getCustomerStyle(cust);
            const statusPill = renderStatusPill(status);
            const rowKey = `search_${num}_${idx}`;
            const isExpanded = Boolean(expandedMoldsMap[rowKey]);
            const commentsHtml = renderCommentsHtml(num);
            const isCascade = idx < 8;
            const cascadeClass = isCascade ? ' cascade-item' : '';
            const cascadeStyle = isCascade ? ` style="--cascade-delay: ${idx * 34}ms;"` : '';

            return `
                <tr id="accordion-trigger-${rowKey}" class="${cascadeClass.trim()}" ${cascadeStyle} data-mold-id="${escapeHtml(num)}" oncontextmenu="handleMoldRowRightClick(event, '${escapeHtml(num)}')">
                    <td>
                        <div class="mold-cell-content">
                            <button id="accordion-btn-${rowKey}" class="toggle-accordion-btn ${isExpanded ? 'expanded' : ''}" onclick="toggleAccordion('${rowKey}', '${escapeHtml(num)}')">▼</button>
                            <span class="mold-clickable-id" onclick="toggleAccordion('${rowKey}', '${escapeHtml(num)}')" style="font-weight: 600; cursor: pointer;">${escapeHtml(num)}</span>
                            ${statusPill}
                        </div>
                        ${productName ? `<div class="product-name-sub">${escapeHtml(productName)}</div>` : ''}
                        ${commentsHtml}
                    </td>
                    <td>
                        <span class="tag-customer" style="${custStyle}" onclick="openCustomerModal('${escapeHtml(num)}', '${escapeHtml(cust)}')" oncontextmenu="handleTagRightClick(event, '${escapeHtml(cust)}')">${escapeHtml(cust)}</span>
                    </td>
                    <td>
                        ${renderPositionCellHtml(num, pos, status, productName, prevPos)}
                    </td>
                </tr>
            `;
        }).join('');
        triggerSafeCascade(tbody);
    }

    function filterCustomer(customerName, element) {
        if (customerDragMoved) return;
        triggerHapticFeedback([12]);
        currentCustomerFilter = customerName;

        const container = document.getElementById('customerFilters');
        if (container) {
            container.querySelectorAll('.filter-chip').forEach(chip => chip.classList.remove('active'));
        }
        if (element) {
            element.classList.add('active');
            if (typeof element.scrollIntoView === 'function') {
                element.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
            }
        } else if (container) {
            const chips = container.querySelectorAll('.filter-chip');
            chips.forEach(c => {
                const text = c.querySelector('span') ? c.querySelector('span').textContent.trim() : c.textContent.trim();
                if ((customerName === 'ALL' && text === 'Vše') || text.toLowerCase() === customerName.toLowerCase()) {
                    c.classList.add('active');
                }
            });
        }

        renderFullDatabase();
    }

    function filterDashboardStatus(statusName, cardElement) {
        triggerHapticFeedback([12]);
        document.querySelectorAll('.dash-card').forEach(c => c.classList.remove('active'));
        cardElement.classList.add('active');
        currentDashboardStatusFilter = statusName;
        renderDashboard();
    }
</script>
</body>
</html>