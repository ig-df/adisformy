    function triggerSafeCascade(tbody) {
        if (!tbody) return;
        const container = tbody.closest('.table-container') || tbody;
        const cleanAll = () => {
            const items = tbody.querySelectorAll('.cascade-item');
            if (items.length > 0) {
                items.forEach(el => {
                    el.classList.remove('cascade-item');
                    el.style.animation = '';
                    el.style.animationDelay = '';
                    el.style.willChange = '';
                });
            }
            container.removeEventListener('touchstart', cleanAll);
            container.removeEventListener('scroll', cleanAll);
            container.removeEventListener('mousedown', cleanAll);
        };
        container.addEventListener('touchstart', cleanAll, { passive: true, once: true });
        container.addEventListener('scroll', cleanAll, { passive: true, once: true });
        container.addEventListener('mousedown', cleanAll, { passive: true, once: true });
        clearTimeout(tbody._cascadeTimer);
        tbody._cascadeTimer = setTimeout(cleanAll, 520);
    }

