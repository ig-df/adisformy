    function handleDirectProdFiles(inputElement) {
        if (inputElement.files && inputElement.files.length > 0) {
            triggerHapticFeedback([12]);
            for (let i = 0; i < inputElement.files.length; i++) {
                if (directProdPendingFiles.length >= 2) {
                    alert("Můžete připojit maximálně 2 fotografie!");
                    break;
                }
                directProdPendingFiles.push(inputElement.files[i]);
            }
            renderDirectProdThumbs();
        }
    }

    function removeDirectProdFile(index) {
        triggerHapticFeedback([12]);
        const file = directProdPendingFiles[index];
        if (file && file._previewUrl) URL.revokeObjectURL(file._previewUrl);
        directProdPendingFiles.splice(index, 1);
        renderDirectProdThumbs();
    }

    function renderDirectProdThumbs() {
        const container = document.getElementById('directProdThumbsContainer');
        const uploadBtn = document.getElementById('directProdUploadBtn');
        if (!container) return;

        container.innerHTML = directProdPendingFiles.map((file, idx) => {
            if (!file._previewUrl) file._previewUrl = URL.createObjectURL(file);
            return `
                <div class="accordion-thumb-wrapper" style="border-color: #3b82f6;">
                    <img src="${file._previewUrl}" class="accordion-thumb">
                    <button type="button" class="accordion-thumb-remove" onclick="removeDirectProdFile(${idx})">&times;</button>
                </div>
            `;
        }).join('');

        if (uploadBtn) uploadBtn.style.display = directProdPendingFiles.length >= 2 ? 'none' : 'flex';
    }

    async function executeDirectProductionMove() {
        triggerHapticFeedback([22]);
        if (document.activeElement && typeof document.activeElement.blur === 'function') {
            document.activeElement.blur();
        }
        if (isSubmittingAction) return;
        const moldId = document.getElementById('directProdMoldId').value.trim();
        const selectedStatus = document.getElementById('directProdStatus').value;
        const commentText = document.getElementById('directProdComment').value.trim();

        if (!moldId) { alert("Zadejte číslo formy!"); return; }

        isSubmittingAction = true;
        const existing = rawDatabase.find(i => String(i[0]) === moldId);
        const oldPos = existing ? existing[1] : 'Neznámá';
        closeDirectProdModal();

        let targetPosition = 'Mezisklad';
        if (selectedStatus === 'Na opravě pryč') targetPosition = 'Mezisklad Externí';

        let prevPosToSave = existing ? existing[8] : '';
        if (oldPos && !oldPos.toLowerCase().includes('mezisklad')) prevPosToSave = oldPos;

        if (existing) {
            existing[1] = targetPosition; 
            existing[3] = selectedStatus;
            existing[8] = prevPosToSave;
        }

        showToast(`Forma ${moldId} přesunuta na ${targetPosition}`);

        let uploadedPhotoUrls = [];
        for (let file of directProdPendingFiles) {
            const cleanOrigName = sanitizeFileName(file.name || "photo.jpg");
            const fileName = `defect_${moldId}_${Date.now()}_${cleanOrigName}`;
            const { error } = await supabaseClient.storage.from('mold-photos').upload(fileName, file, { upsert: true });
            if (!error) {
                const { data } = supabaseClient.storage.from('mold-photos').getPublicUrl(fileName);
                uploadedPhotoUrls.push(data.publicUrl);
            }
            if (file._previewUrl) URL.revokeObjectURL(file._previewUrl);
        }
        directProdPendingFiles = [];

        try {
            await fetch(`${API_URL}/rest/v1/molds?id=eq.${moldId}`, {
                method: 'PATCH',
                headers: { 'apikey': API_KEY, 'Authorization': `Bearer ${API_KEY}`, 'Content-Type': 'application/json', 'Prefer': 'return=minimal' },
                body: JSON.stringify({ position: targetPosition, status: selectedStatus, previous_position: prevPosToSave })
            });

            await fetch(`${API_URL}/rest/v1/mold_logs`, {
                method: 'POST',
                headers: { 'apikey': API_KEY, 'Authorization': `Bearer ${API_KEY}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ mold_id: moldId, old_position: `Pozice: ${oldPos}`, new_position: `Pozice: ${targetPosition}, Stav: ${selectedStatus}`, user_name: currentUser })
            });

            if (commentText || uploadedPhotoUrls.length > 0) {
                const resComm = await fetch(`${API_URL}/rest/v1/mold_comments`, {
                    method: 'POST',
                    headers: { 
                        'apikey': API_KEY, 
                        'Authorization': `Bearer ${API_KEY}`, 
                        'Content-Type': 'application/json', 
                        'Prefer': 'return=representation' 
                    },
                    body: JSON.stringify({ 
                        mold_id: moldId, 
                        user_name: currentUser, 
                        comment: commentText || 'Odesláno z výroby', 
                        photo_urls: JSON.stringify(uploadedPhotoUrls)
                    })
                });

                if (resComm.ok) {
                    const inserted = await resComm.json();
                    if (inserted && inserted.length > 0) {
                        const newC = inserted[0];
                        newC.photo_urls = uploadedPhotoUrls;
                        allComments.unshift(newC);
                    }
                }
            }
        } catch (e) { console.error(e); }
        finally { 
            setTimeout(() => { isSubmittingAction = false; }, 800);
            refreshUI();
        }
    }

