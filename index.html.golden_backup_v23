            font-weight: 600;
            color: #2563eb;
            cursor: pointer;
            background: none;
            border: none;
            padding: 0;
            transition: opacity 0.2s ease;
            user-select: none;
        }

        .add-email-link:hover {
            opacity: 0.8;
            text-decoration: underline;
        }
    </style>
</head>
