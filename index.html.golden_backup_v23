    function getCroppedReticleCanvas() {
        const video = document.getElementById('scannerVideo');
        const reticle = document.getElementById('scannerReticle');
        if (!video || !reticle || !video.videoWidth || !video.videoHeight) return null;

        const videoRect = video.getBoundingClientRect();
        const reticleRect = reticle.getBoundingClientRect();

        // Calculate scale between displayed video and actual video stream
        const scaleX = video.videoWidth / videoRect.width;
        const scaleY = video.videoHeight / videoRect.height;

        const cropX = Math.max(0, (reticleRect.left - videoRect.left) * scaleX);
        const cropY = Math.max(0, (reticleRect.top - videoRect.top) * scaleY);
        const cropW = Math.min(video.videoWidth - cropX, reticleRect.width * scaleX);
        const cropH = Math.min(video.videoHeight - cropY, reticleRect.height * scaleY);

        if (cropW <= 0 || cropH <= 0) return null;

        const canvas = document.createElement('canvas');
        canvas.width = Math.min(480, Math.round(cropW));
        canvas.height = Math.min(240, Math.round(cropH));
        const ctx = canvas.getContext('2d', { willReadFrequently: true });
        
        ctx.drawImage(video, cropX, cropY, cropW, cropH, 0, 0, canvas.width, canvas.height);

        // Preprocessing: convert to grayscale and boost contrast for high-accuracy digit OCR
        try {
            const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
            const d = imgData.data;
            let sumLum = 0;
            const count = d.length / 4;
            for (let i = 0; i < d.length; i += 4) {
                sumLum += (0.299 * d[i] + 0.587 * d[i+1] + 0.114 * d[i+2]);
            }
            const avgLum = sumLum / count;
            const threshold = avgLum * 0.92;

            for (let i = 0; i < d.length; i += 4) {
                const lum = 0.299 * d[i] + 0.587 * d[i+1] + 0.114 * d[i+2];
                // Sharpen black text on bright tag background
                const val = lum < threshold ? 0 : 255;
                d[i] = val;
                d[i+1] = val;
                d[i+2] = val;
            }
            ctx.putImageData(imgData, 0, 0);
        } catch (e) {}

        return canvas;
    }

    async function scanVideoFrame(isManualSnap = false) {
        if (isScannerProcessing || isScannerLocked) return;
        isScannerProcessing = true;

        const statusText = document.getElementById('scannerStatusText');
        if (isManualSnap && statusText) {
            statusText.textContent = "Rozpoznávám číslo...";
        }

        try {
            const cropCanvas = getCroppedReticleCanvas();
            if (!cropCanvas) {
                isScannerProcessing = false;
                return;
            }

            let candidateNumbers = [];

            // Tier 1: Check Barcode / DataMatrix / QR if supported
            if (scannerBarcodeDetector) {
                try {
                    const barcodes = await scannerBarcodeDetector.detect(cropCanvas);
                    if (barcodes && barcodes.length > 0) {
                        for (const b of barcodes) {
                            const val = (b.rawValue || '').trim();
                            const digits = val.match(/[0-9]+([/-][0-9]+)?/g);
                            if (digits) candidateNumbers.push(...digits);
                        }
                    }
                } catch (bErr) {}
            }

            // Tier 2: OCR with Tesseract
            if (candidateNumbers.length === 0) {
                const worker = await getTesseractWorker();
                if (worker) {
                    const ret = await worker.recognize(cropCanvas);
                    const text = (ret && ret.data && ret.data.text) ? ret.data.text.trim() : '';
                    if (text) {
                        const matches = text.match(/[0-9]+([/-][0-9]+)?/g);
                        if (matches) candidateNumbers.push(...matches);
                    }
                }
            }

            if (candidateNumbers.length > 0) {
                // Match candidate numbers against rawDatabase
                let matched = null;
                for (const cand of candidateNumbers) {
                    const cleanCand = cand.trim();
                    if (!cleanCand) continue;

                    // 1. Exact ID string match
                    matched = rawDatabase.find(item => !item[4] && String(item[0]).trim() === cleanCand);
                    if (matched) break;

                    // 2. Numeric match (ignore leading zeros, e.g. 054 -> 54)
                    const candInt = parseInt(cleanCand, 10);
                    if (!isNaN(candInt)) {
                        matched = rawDatabase.find(item => !item[4] && parseInt(item[0], 10) === candInt);
                        if (matched) break;
                    }
                }

                if (matched) {
                    handleMoldMatchFound(matched);
                    return;
                } else if (isManualSnap) {
                    const detectedNum = candidateNumbers[0];
                    showToast(`Rozpoznáno číslo ${detectedNum}, ale forma není v databázi.`);
                    if (statusText) statusText.textContent = `Rozpoznáno: #${detectedNum} (Nenalezeno v databázi)`;
                    playScannerAudioBeep(false);
                }
            } else if (isManualSnap) {
                showToast("Číslo štítku se nepodařilo rozpoznat. Zkuste zaostřit nebo použít blesk.");
                if (statusText) statusText.textContent = "Číslo nerozpoznáno. Zkuste znovu.";
                playScannerAudioBeep(false);
            }
        } catch (e) {
            console.error("Chyba při skenování snímku:", e);
        } finally {
            isScannerProcessing = false;
        }
    }

