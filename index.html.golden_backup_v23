    async function renderOnlineUsers() {
        const container = document.getElementById('onlineUsersContainer');
        if (!container) return;

        try {
            const { data: sessions, error } = await supabaseClient
                .from('active_sessions')
                .select('*')
                .order('last_seen', { ascending: false });

            if (error || !sessions || sessions.length === 0) {
                container.innerHTML = '<div style="font-size: 0.78rem; color: var(--text-muted);">Žádní aktivní uživatelé.</div>';
                updateOnlineBadge();
                return;
            }

            const now = new Date();

            container.innerHTML = sessions.map(session => {
                const lastSeen = new Date(session.last_seen);
                const diffMinutes = Math.floor((now - lastSeen) / 60000);
                const diffHours = (diffMinutes / 60).toFixed(1);

                let statusBadge = '';
                if (diffMinutes < 30) {
                    statusBadge = '<span class="status-pill" style="border-color: #bbf7d0; background: #f0fdf4; color: #15803d; font-size: 0.7rem; padding: 2px 6px; border-radius: 4px; border: 1px solid;"><span class="status-dot dot-green" style="display:inline-block; width:6px; height:6px; background:#22c55e; border-radius:50%; margin-right:4px;"></span>Online</span>';
                } else if (diffMinutes <= 1440) { 
                    const timeLabel = diffMinutes < 60 ? `${diffMinutes}m` : `${diffHours}h`;
                    statusBadge = `<span class="status-pill" style="border-color: #fef08a; background: #fefce8; color: #a16207; font-size: 0.7rem; padding: 2px 6px; border-radius: 4px; border: 1px solid;"><span class="status-dot dot-yellow" style="display:inline-block; width:6px; height:6px; background:#eab308; border-radius:50%; margin-right:4px;"></span>${timeLabel}</span>`;
                } else {
                    statusBadge = `<span class="status-pill" style="border-color: #e2e8f0; background: #f8fafc; color: var(--text-muted, #64748b); font-size: 0.7rem; padding: 2px 6px; border-radius: 4px; border: 1px solid;"><span class="status-dot" style="display:inline-block; width:6px; height:6px; background:#cbd5e1; border-radius:50%; margin-right:4px;"></span>Off</span>`;
                }

                const roleBadge = session.role === 'superuser' ? '<span style="color:#ef4444; font-weight:bold; font-size:0.7rem; margin-left:2px;">(Admin)</span>' : '';
                const deviceBadge = getDeviceBadgeHtml(session.device_type);

                return `
                    <div class="online-user-item" onclick="openUserActivityModal('${escapeHtml(session.user_name)}', '${escapeHtml(session.device_type || '')}', '${session.last_seen}')" title="Klikněte pro zobrazení podrobné aktivity uživatele">
                        <div>
                            <div style="display: flex; align-items: center; gap: 4px;">
                                <strong style="color: var(--text-main, #0f172a);">${escapeHtml(session.user_name)}</strong> ${roleBadge}
                            </div>
                            <div style="margin-top: 2px;">
                                ${deviceBadge}
                            </div>
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.35rem;">
                            ${statusBadge}
                            <span style="font-size: 0.75rem; color: rgba(0, 0, 0, 0.3);">›</span>
                        </div>
                    </div>
                `;
            }).join('');

            updateOnlineBadge();

        } catch (e) {
            console.error("Chyba při načítání relací:", e);
            container.innerHTML = '<div style="font-size: 0.78rem; color: var(--error-badge);">Chyba načítání dat.</div>';
        }
    }

